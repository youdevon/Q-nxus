  projectedQualifyingNis            Decimal                        @db.Decimal(14, 2)
  projectedPension                  Decimal                        @default(0) @db.Decimal(14, 2)
  projectedOtherQualifyingContributions Decimal                    @default(0) @db.Decimal(14, 2)
