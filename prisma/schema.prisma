model EmploymentContract {
  id                String                   @id @default(cuid())
  employeeId        String
  sourceContractId  String?
  contractNumber    String?
  contractType      EmploymentContractType
  changeType        ContractChangeType       @default(INITIAL)
  status            EmploymentContractStatus @default(DRAFT)
  startDate         DateTime
  endDate           DateTime?
  jobTitle          String
  baseSalary        Decimal                  @db.Decimal(14, 2)
  currency          String                   @default("TTD")
  gratuityEligible  Boolean                  @default(false)
  gratuityRate      Decimal?                 @db.Decimal(5, 2)
  gratuityTaxRate   Decimal?                 @db.Decimal(5, 2)
  /// Arrangement (optional; assignment still authoritative for current seat).
  positionId        String?
  departmentId      String?
  fte               Decimal?                 @db.Decimal(5, 2)
  standardHoursPerWeek Decimal?              @db.Decimal(6, 2)
  probationEndDate  DateTime?                @db.Date
  noticePeriodDays  Int?
  /// Governance
  approvedAt        DateTime?
  approvedByUserId  String?
  employeeSignedAt  DateTime?
  orgSignedAt       DateTime?
  activatedAt       DateTime?
  /// At most one row per employee may be true — enforced by partial unique index
  /// `employment_contracts_one_current` (see migration; not expressible as @@unique).
  isCurrent         Boolean                  @default(false)
  signedDate        DateTime?
  collectedAt       DateTime?
  terminationDate   DateTime?
  terminationReason String?
  documentReference String?
  /// Filed executed / draft contract PDF (denormalized; also linked via storedFileId).
  documentStorageKey String?
  documentFileName   String?
  documentMimeType   String?
  documentSize       Int?
  storedFileId       String?
  notes             String?
  /// Entitlement overrides captured at draft time; applied on activate.
  vacationLeaveDaysOverride Decimal?         @db.Decimal(9, 2)
  sickLeaveDaysOverride     Decimal?         @db.Decimal(9, 2)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  employee       Employee                      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sourceContract EmploymentContract?           @relation("ContractHistory", fields: [sourceContractId], references: [id], onDelete: SetNull)
  amendments     EmploymentContract[]          @relation("ContractHistory")
  allowances     EmploymentContractAllowance[]
  approvalSteps  EmploymentContractApprovalStep[]
  position       Position?                     @relation(fields: [positionId], references: [id], onDelete: SetNull)
  department     Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  approvedBy     User?                         @relation("ContractApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  storedFile     StoredFile?                   @relation(fields: [storedFileId], references: [id], onDelete: SetNull)

  leaveBalances     EmployeeLeaveBalance[]
  leaveTransactions LeaveBalanceTransaction[]

  leaveRequests LeaveRequest[]

  @@index([employeeId])
  @@index([employeeId, isCurrent])
  @@index([status])
  @@index([endDate])
  @@index([isCurrent, endDate])
  @@index([sourceContractId])
  @@index([positionId])
  @@index([departmentId])
  @@index([approvedByUserId])
  @@index([storedFileId])
  @@map("employment_contracts")
  @@schema("hr")
}

