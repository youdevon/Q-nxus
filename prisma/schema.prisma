  approverUserId     String?
  approverPositionId String?
  status             LeaveApprovalStatus @default(PENDING)
  assignedAt         DateTime            @default(now())
  decidedAt          DateTime?
  decisionComment    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  leaveRequest     LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  approverUser     User?        @relation("LeaveApprovalUser", fields: [approverUserId], references: [id], onDelete: SetNull)
  approverPosition Position?    @relation(fields: [approverPositionId], references: [id], onDelete: SetNull)

  @@unique([leaveRequestId, stepNumber])
  @@index([approverUserId, status])
  @@index([approverUserId])
  @@index([approverPositionId])
  @@index([status])
  @@map("leave_approval_steps")
  @@schema("hr")
}

model LeaveRequestAcknowledgement {
