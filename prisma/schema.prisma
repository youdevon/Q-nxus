  requiresDocument       Boolean   @default(false)
  documentRequiredAfter  Decimal?  @db.Decimal(7, 2)
  minimumNoticeDays      Int       @default(0)
  maximumConsecutiveDays Decimal?  @db.Decimal(7, 2)
  allowsHalfDay          Boolean   @default(false)
  allowsNegativeBalance  Boolean   @default(false)
  carryForwardAllowed    Boolean   @default(false)
  carryForwardLimit      Decimal?  @db.Decimal(9, 2)
  carryForwardExpiryDays Int?
