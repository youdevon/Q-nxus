# Q-NXUS application address
APP_BASE_URL=http://localhost:3000

# PostgreSQL (required). Prisma uses multiple schemas: core, hr, payroll, notifications, audit.
# Example: postgresql://USER:PASSWORD@localhost:5432/appdb
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/appdb"

# Signed session cookies (min 16 characters) — never commit the real value
AUTH_SECRET=dev-only-change-me-now

# Optional dedicated key for bank account number encryption at rest (AES-256-GCM).
# Falls back to AUTH_SECRET when unset. Min 16 characters. Rotate carefully —
# ciphertext encrypted with the old key cannot be decrypted after a key change
# unless you re-encrypt with scripts/migrate-encrypt-bank-accounts.ts.
# BANK_ACCOUNT_ENCRYPTION_KEY=
# Maker-checker on pay-run post (default: required). Set to false only for single-user demos.
# PAYROLL_RUN_APPROVAL_REQUIRED=false

# Enables Danger zone wipes on Administration → Domain Settings (system admin only).
# ALLOW_DEMO_DATA_RESET=true

# Initial password for auto-provisioned employee user accounts
DEFAULT_EMPLOYEE_PASSWORD=ChangeMe123!

# System-wide SMTP delivery (forfeiture / leave alerts can queue email when enabled)
SMTP_ENABLED=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Q-NXUS
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_MAX_CONNECTIONS=3
EMAIL_MAX_ATTEMPTS=3

# Background jobs: email queue, ack/expiry/forfeiture reminders, retention archive.
# Prefer false for local day-to-day; use `npm run jobs:run` on demand or cron in prod.
# Set true only if you want an in-process 15-minute scheduler (see instrumentation.ts).
ENABLE_BACKGROUND_JOBS=false
