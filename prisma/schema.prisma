  leaveBalance EmployeeLeaveBalance? @relation(fields: [leaveBalanceId], references: [id], onDelete: SetNull)
  createdBy    User?                 @relation("LeaveTransactionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([contractId])
  @@index([leaveTypeId])
  @@index([leaveBalanceId])
  @@index([transactionType])
  @@index([effectiveDate])
  @@index([referenceType, referenceId])
  @@index([createdByUserId])
  @@map("leave_balance_transactions")
  @@schema("hr")
}

model LeaveRequest {
  id                    String             @id @default(cuid())
  organizationId        String
  employeeId            String
  contractId            String
  leaveTypeId           String
  leaveBalanceId        String?
  requestNumber         String?
  startDate             DateTime
  endDate               DateTime
  requestedQuantity     Decimal            @db.Decimal(9, 2)
  reason                String?
  employeeComment       String?
  status                LeaveRequestStatus @default(DRAFT)
  submittedAt           DateTime?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  cancelledAt           DateTime?
  withdrawnAt           DateTime?
  finalDecisionByUserId String?
  finalDecisionComment  String?
  createdByUserId       String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee        Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contract        EmploymentContract    @relation(fields: [contractId], references: [id], onDelete: Restrict)
  leaveType       LeaveType             @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  leaveBalance    EmployeeLeaveBalance? @relation(fields: [leaveBalanceId], references: [id], onDelete: SetNull)
  finalDecisionBy User?                 @relation("LeaveFinalDecisionUser", fields: [finalDecisionByUserId], references: [id], onDelete: SetNull)
  createdBy       User?                 @relation("LeaveRequestCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  days             LeaveRequestDay[]
  approvalSteps    LeaveApprovalStep[]
  acknowledgements LeaveRequestAcknowledgement[]
  attachments      LeaveAttachment[]

  @@unique([organizationId, requestNumber])
  @@index([organizationId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, status, submittedAt])
  @@index([organizationId, status, startDate, endDate])
  @@index([employeeId])
  @@index([contractId])
  @@index([leaveTypeId])
  @@index([leaveBalanceId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([finalDecisionByUserId])
  @@index([createdByUserId])
  @@map("leave_requests")
  @@schema("hr")
}

model LeaveRequestDay {
  id              String   @id @default(cuid())
  leaveRequestId  String
  leaveDate       DateTime
  quantity        Decimal  @db.Decimal(7, 2)
  isWorkingDay    Boolean  @default(true)
  isPublicHoliday Boolean  @default(false)
  note            String?
  createdAt       DateTime @default(now())

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@unique([leaveRequestId, leaveDate])
  @@index([leaveDate])
  @@map("leave_request_days")
  @@schema("hr")
}

model LeaveApprovalStep {
  id                 String              @id @default(cuid())
