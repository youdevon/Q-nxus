generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["core", "hr", "payroll", "notifications", "audit"]
}

enum ModuleHealth {
  OPERATIONAL
  DEGRADED
  UNAVAILABLE

  @@schema("core")
}

enum OrganizationStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  INACTIVE
  ARCHIVED

  @@schema("core")
}

enum UserAccountStatus {
  INVITED
  ACTIVE
  LOCKED
  SUSPENDED
  DISABLED
  ARCHIVED

  @@schema("core")
}

enum RoleAssignmentStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED

  @@schema("core")
}

/// How a UserRole grant was created. Sync and revoke paths key off this,
/// not free-text reason strings.
enum UserRoleSource {
  MANUAL
  POSITION
  SELF_SERVICE
  SYSTEM

  @@schema("core")
}

enum ConfigurationStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED

  @@schema("core")
}

enum SettingDataType {
  STRING
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
  DATETIME
  JSON

  @@schema("core")
}

enum SequenceResetFrequency {
  NEVER
  MONTHLY
  ANNUALLY
  FINANCIAL_YEAR
  MANUAL

  @@schema("core")
}

