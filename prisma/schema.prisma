generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["core", "hr", "payroll", "notifications", "audit"]
}

enum ModuleHealth {
  OPERATIONAL
  DEGRADED
  UNAVAILABLE

  @@schema("core")
}

enum OrganizationStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  INACTIVE
  ARCHIVED

  @@schema("core")
}

enum UserAccountStatus {
  INVITED
  ACTIVE
  LOCKED
  SUSPENDED
  DISABLED
  ARCHIVED

  @@schema("core")
}

enum RoleAssignmentStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED

  @@schema("core")
}

/// How a UserRole grant was created. Sync and revoke paths key off this,
/// not free-text reason strings.
enum UserRoleSource {
  MANUAL
  POSITION
  SELF_SERVICE
  SYSTEM

  @@schema("core")
}

enum ConfigurationStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED

  @@schema("core")
}

enum SettingDataType {
  STRING
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
  DATETIME
  JSON

  @@schema("core")
}

enum SequenceResetFrequency {
  NEVER
  MONTHLY
  ANNUALLY
  FINANCIAL_YEAR
  MANUAL

  @@schema("core")
}

enum EmployeeAssignmentType {
  INITIAL_APPOINTMENT
  TRANSFER
  PROMOTION
  DEMOTION
  ACTING_APPOINTMENT
  TEMPORARY_ASSIGNMENT
  SECONDMENT
  REASSIGNMENT
  RETURN_TO_SUBSTANTIVE
  OTHER

  @@schema("hr")
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RETIRED
  INACTIVE

  @@schema("hr")
}

enum JobDescriptionStatus {
  DRAFT
  ACTIVE
  RETIRED
  ARCHIVED

  @@schema("hr")
}

enum JobCriterionType {
  DUTY
  RESPONSIBILITY
  PERFORMANCE_OBJECTIVE
  KEY_PERFORMANCE_INDICATOR
  TECHNICAL_COMPETENCY
  BEHAVIOURAL_COMPETENCY
  QUALIFICATION
  EXPERIENCE
  OTHER

  @@schema("hr")
}

enum AllowanceFrequency {
  MONTHLY
  WEEKLY
  BIWEEKLY
  PER_PAY_PERIOD
  ANNUAL
  ONE_TIME

  @@schema("hr")
}

enum EmploymentContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  SUPERSEDED
  TERMINATED
  CANCELLED

  @@schema("hr")
}

enum EmploymentContractType {
  PERMANENT
  FIXED_TERM
  TEMPORARY
  PART_TIME
  INTERNSHIP
  CONSULTANCY
  ACTING
  SECONDMENT
  OTHER

  @@schema("hr")
}

enum ContractChangeType {
  INITIAL
  RENEWAL
  EXTENSION
  AMENDMENT
  SALARY_ADJUSTMENT
  POSITION_CHANGE
  TERMINATION
  OTHER

  @@schema("hr")
}

enum LeaveUnit {
  DAYS
  HOURS

  @@schema("hr")
}

enum LeaveAccrualMethod {
  ANNUAL_GRANT
  MONTHLY
  PER_PAY_PERIOD
  MANUAL
  NONE

  @@schema("hr")
}

enum LeaveBalanceTransactionType {
  OPENING_BALANCE
  ENTITLEMENT
  ACCRUAL
  CARRY_FORWARD
  REQUEST_RESERVED
  REQUEST_RELEASED
  LEAVE_TAKEN
  ADJUSTMENT
  EXPIRY
  REVERSAL

  @@schema("hr")
}

enum LeaveRequestStatus {
  DRAFT
  SUBMITTED
  /// Reporting-line acknowledgements outstanding (ack-then-final modes).
  AWAITING_ACKNOWLEDGEMENT
  PENDING_APPROVAL
  MANAGER_APPROVED
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN

  @@schema("hr")
}

enum LeaveApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
  CANCELLED

  @@schema("hr")
}

enum LeaveAcknowledgementStatus {
  PENDING
  ACKNOWLEDGED
  SKIPPED
  CANCELLED

  @@schema("hr")
}

enum PerformanceAppraisalStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  SUPERVISOR_REVIEWED
  EMPLOYEE_ACKNOWLEDGED
  COMPLETED
  CANCELLED

  @@schema("hr")
}

enum PerformanceRatingScale {
  ONE_TO_FIVE
  ONE_TO_TEN
  PERCENTAGE

  @@schema("hr")
}

enum CorrespondenceCategory {
  RECOMMENDATION
  DISCIPLINARY
  WARNING
  INSTRUCTION
  COMMENDATION
  PERFORMANCE
  GENERAL
  OTHER
  POLICY
  OFFER_LETTER
  EXIT_CLEARANCE
  MEDICAL
  IDENTIFICATION

  @@schema("hr")
}

enum CorrespondenceStatus {
  DRAFT
  ISSUED
  ACKNOWLEDGED
  ARCHIVED
  SUPERSEDED

  @@schema("hr")
}

enum EmployeeCorrespondenceResponseStatus {
  OPEN
  REVIEWED

  @@schema("hr")
}

/// Top-level qualification category (Caribbean HR taxonomy).
/// Use qualificationSubtype for CSEC/CAPE, Cambridge levels, etc.
enum QualificationDocumentType {
  CXC
  CAMBRIDGE
  PEARSON_EDEXCEL
  IB
  VOCATIONAL
  UNIVERSITY
  PROFESSIONAL
  TRADE_LICENCE
  ADMISSION_ASSESSMENT
  OTHER

  @@schema("hr")
}

/// Specific degree award when documentType is UNIVERSITY.
/// Grouped by academic band in the UI; authority sort derives band from type.
enum QualificationDegreeType {
  // Undergraduate
  ASSOCIATE
  BA
  BSC
  BBA
  BCOM
  BED
  BENG
  LLB
  MBBS
  BN
  BFA
  BTECH
  BSW
  BPHARM
  // Postgraduate
  PGCERT
  PGDIP
  MA
  MSC
  MBA
  MED
  MENG
  LLM
  MPA
  MPH
  MSW
  MPHIL
  EMBA
  // Doctoral
  PHD
  DBA
  EDD
  DENG
  MD
  DRPH
  PSYD
  DNP
  JD
  // Other higher-education
  CERTIFICATE
  DIPLOMA
  HNC
  HND
  FOUNDATION
  GRADCERT
  GRADDIP
  PROFESSIONAL_DEGREE
  HONORARY
  OTHER

  @@schema("hr")
}

/// Standard onboarding / employee-file checklist document types.
enum EmployeeFileChecklistItemType {
  ACADEMIC_CERTIFICATES
  COPY_OF_ID
  BIRTH_CERTIFICATE
  MARRIAGE_CERTIFICATE
  ASSUMPTION_OF_DUTY

  @@schema("hr")
}

enum EmployeeFileUpdateRequestStatus {
  OPEN
  RESOLVED

  @@schema("hr")
}

enum EmployeeFileUpdateRequestType {
  QUALIFICATION_UPDATE

  @@schema("hr")
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  TEMPORARY
  PART_TIME
  INTERN
  CONSULTANT

  @@schema("hr")
}

/// Distinguishes full HR employees from non-employee payees (agents, board, contractors).
/// Non-EMPLOYEE categories use EmploymentContract for time-bounded engagement; they do not get employee files.
enum WorkforceCategory {
  EMPLOYEE
  AGENT
  BOARD
  /// Consultants and similar non-employee payees.
  CONTRACTOR

  @@schema("hr")
}

/// Government / travel identity document used for employee verification.
enum EmployeeIdType {
  NATIONAL_ID
  DRIVERS_PERMIT
  /// Passport or foreign ID for non-nationals.
  NON_NATIONAL

  @@schema("hr")
}

enum EmailDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED

  @@schema("notifications")
}

enum EmailPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@schema("notifications")
}

enum NotificationSeverity {
  SUCCESS
  INFORMATION
  WARNING
  ERROR
  CRITICAL

  @@schema("notifications")
}

enum NotificationReadStatus {
  UNREAD
  READ
  DISMISSED

  @@schema("notifications")
}

model Organization {
  id              String             @id @default(cuid())
  code            String             @unique
  name            String
  shortName       String?
  legalName       String?
  email           String?
  phone           String?
  website         String?
  status          OrganizationStatus @default(DRAFT)
  defaultTimeZone String             @default("America/Port_of_Spain")
  defaultCurrency String             @default("TTD")
  defaultLanguage String             @default("en")
  dateFormat      String             @default("dd/MM/yyyy")
  firstDayOfWeek  Int                @default(1)
  version         Int                @default(1)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  archivedAt      DateTime?

  departments         Department[]
  users               User[]
  employees           Employee[]
  roles               Role[]
  businessUnits       BusinessUnit[]
  locations           Location[]
  referenceDataSets   ReferenceDataSet[]
  featureControls     FeatureControl[]
  domainSettings      DomainSetting[]
  numberingSequences  NumberingSequence[]
  allowanceCategories AllowanceCategory[]

  leaveTypes            LeaveType[]
  leaveEntitlementRules LeaveEntitlementRule[]
  organizationHolidays  OrganizationHoliday[]

  leaveRequests LeaveRequest[]
  employeeCorrespondences EmployeeCorrespondence[]
  correspondenceTemplates CorrespondenceTemplate[]
  employeeCredentials     EmployeeCredential[]
  employeeTrainingRecords EmployeeTrainingRecord[]
  employeeQualificationDocuments EmployeeQualificationDocument[]
  employeeFileChecklistItems EmployeeFileChecklistItem[]
  employeeFileUpdateRequests EmployeeFileUpdateRequest[]
  employeeCorrespondenceResponses EmployeeCorrespondenceResponse[]

  nisEarningsClasses       NisEarningsClass[]
  payeTaxConfigs           PayeTaxConfig[]
  healthSurchargeConfigs   HealthSurchargeConfig[]
  payrollPeriods           PayrollPeriod[]
  payRuns                  PayRun[]
  payslips                 Payslip[]
  payrollLineItems         PayrollLineItem[]
  employeeBankAccounts     EmployeeBankAccount[]
  employeePayrollAllocations EmployeePayrollAllocation[]
  payrollPayments          PayrollPayment[]
  achPaymentBatches        AchPaymentBatch[]
  bankExportProfiles       BankExportProfile[]
  auditEvents              AuditEvent[]

  @@index([status])
  @@map("organizations")
  @@schema("core")
}

model OrganizationHoliday {
  id             String   @id @default(cuid())
  organizationId String
  holidayDate    DateTime @db.Date
  name           String
  isRecurring    Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, holidayDate, name])
  @@index([organizationId, holidayDate])
  @@index([organizationId, isActive])
  @@map("organization_holidays")
  @@schema("hr")
}

model ApplicationSetting {
  id               String   @id @default(cuid())
  internalCodename String   @default("Q-NXUS")
  displayName      String   @default("Q-NXUS")
  shortName        String   @default("Q-NXUS")
  organizationName String?
  logoUrl          String?
  faviconUrl       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("application_settings")
  @@schema("core")
}

model User {
  id                  String            @id @default(cuid())
  organizationId      String
  email               String            @unique
  firstName           String
  lastName            String
  passwordHash        String?
  mustChangePassword  Boolean           @default(false)
  status              UserAccountStatus @default(INVITED)
  isActive            Boolean           @default(true)
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int               @default(0)
  lockedUntil         DateTime?
  version             Int               @default(1)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  archivedAt          DateTime?

  organization         Organization            @relation(fields: [organizationId], references: [id])
  roles                UserRole[]
  notifications        NotificationRecipient[]
  auditEvents          AuditEvent[]
  supervisedAppraisals PerformanceAppraisal[]  @relation("AppraisalSupervisor")

  createdLeaveTransactions LeaveBalanceTransaction[] @relation("LeaveTransactionCreator")

  createdLeaveRequests     LeaveRequest[]      @relation("LeaveRequestCreator")
  finalLeaveDecisions      LeaveRequest[]      @relation("LeaveFinalDecisionUser")
  leaveApprovalSteps       LeaveApprovalStep[] @relation("LeaveApprovalUser")
  leaveAcknowledgements    LeaveRequestAcknowledgement[] @relation("LeaveAcknowledgementUser")
  uploadedLeaveAttachments LeaveAttachment[]   @relation("LeaveAttachmentUploader")

  issuedCorrespondences              EmployeeCorrespondence[] @relation("CorrespondenceIssuer")
  acknowledgedCorrespondences        EmployeeCorrespondence[] @relation("CorrespondenceAcknowledger")
  uploadedCorrespondenceAttachments  EmployeeCorrespondenceAttachment[] @relation("CorrespondenceAttachmentUploader")
  confirmedAssumptionOfDutyItems     EmployeeFileChecklistItem[] @relation("AssumptionOfDutyConfirmer")
  requestedFileUpdates               EmployeeFileUpdateRequest[] @relation("FileUpdateRequester")
  resolvedFileUpdates                EmployeeFileUpdateRequest[] @relation("FileUpdateResolver")
  reviewedCorrespondenceResponses      EmployeeCorrespondenceResponse[] @relation("CorrespondenceResponseReviewer")

  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("users")
  @@schema("core")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String?
  code           String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?    @relation(fields: [organizationId], references: [id])
  users        UserRole[]
  permissions  RolePermission[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
  @@schema("core")
}

model UserRole {
  id               String               @id @default(cuid())
  userId           String
  roleId           String
  status           RoleAssignmentStatus @default(ACTIVE)
  effectiveFrom    DateTime             @default(now())
  effectiveUntil   DateTime?
  assignedAt       DateTime             @default(now())
  revokedAt        DateTime?
  reason           String?
  /// Provenance for sync/revoke — do not infer from reason text.
  source           UserRoleSource       @default(MANUAL)
  /// When source is POSITION, the Position that granted this role (optional).
  sourcePositionId String?

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  sourcePosition Position? @relation(fields: [sourcePositionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([roleId, status])
  @@index([userId, source, status])
  @@index([effectiveFrom, effectiveUntil])
  @@index([sourcePositionId])
  @@map("user_roles")
  @@schema("core")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  moduleKey   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@index([moduleKey])
  @@map("permissions")
  @@schema("core")
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
  @@schema("core")
}

model BusinessUnit {
  id             String              @id @default(cuid())
  organizationId String
  parentId       String?
  code           String
  name           String
  description    String?
  status         ConfigurationStatus @default(ACTIVE)
  effectiveFrom  DateTime            @default(now())
  effectiveUntil DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  parent       BusinessUnit?  @relation("BusinessUnitHierarchy", fields: [parentId], references: [id])
  children     BusinessUnit[] @relation("BusinessUnitHierarchy")

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([parentId])
  @@map("business_units")
  @@schema("core")
}

model Location {
  id             String              @id @default(cuid())
  organizationId String
  code           String
  name           String
  locationType   String
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  countryCode    String              @default("TT")
  postalCode     String?
  timeZone       String              @default("America/Port_of_Spain")
  status         ConfigurationStatus @default(ACTIVE)
  effectiveFrom  DateTime            @default(now())
  effectiveUntil DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("locations")
  @@schema("core")
}

model ReferenceDataSet {
  id             String              @id @default(cuid())
  organizationId String?
  code           String
  name           String
  description    String?
  moduleKey      String
  status         ConfigurationStatus @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization?        @relation(fields: [organizationId], references: [id])
  values       ReferenceDataValue[]

  @@unique([organizationId, code])
  @@index([moduleKey])
  @@map("reference_data_sets")
  @@schema("core")
}

model ReferenceDataValue {
  id             String              @id @default(cuid())
  dataSetId      String
  parentId       String?
  code           String
  label          String
  description    String?
  sortOrder      Int                 @default(0)
  status         ConfigurationStatus @default(ACTIVE)
  effectiveFrom  DateTime            @default(now())
  effectiveUntil DateTime?
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  dataSet  ReferenceDataSet     @relation(fields: [dataSetId], references: [id], onDelete: Cascade)
  parent   ReferenceDataValue?  @relation("ReferenceValueHierarchy", fields: [parentId], references: [id])
  children ReferenceDataValue[] @relation("ReferenceValueHierarchy")

  @@unique([dataSetId, code])
  @@index([dataSetId, status])
  @@index([parentId])
  @@map("reference_data_values")
  @@schema("core")
}

model FeatureControl {
  id             String              @id @default(cuid())
  organizationId String
  featureCode    String
  isEnabled      Boolean             @default(false)
  status         ConfigurationStatus @default(ACTIVE)
  effectiveFrom  DateTime            @default(now())
  effectiveUntil DateTime?
  reason         String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, featureCode])
  @@index([organizationId, isEnabled])
  @@map("feature_controls")
  @@schema("core")
}

model DomainSetting {
  id             String              @id @default(cuid())
  organizationId String
  settingCode    String
  moduleKey      String
  name           String
  description    String?
  dataType       SettingDataType
  value          Json
  isSensitive    Boolean             @default(false)
  status         ConfigurationStatus @default(ACTIVE)
  effectiveFrom  DateTime            @default(now())
  effectiveUntil DateTime?
  version        Int                 @default(1)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, settingCode])
  @@index([organizationId, moduleKey])
  @@map("domain_settings")
  @@schema("core")
}

model NumberingSequence {
  id             String                 @id @default(cuid())
  organizationId String
  sequenceCode   String
  prefix         String?
  suffix         String?
  currentNumber  BigInt                 @default(0)
  minimumLength  Int                    @default(5)
  resetFrequency SequenceResetFrequency @default(NEVER)
  lastResetAt    DateTime?
  isActive       Boolean                @default(true)
  version        Int                    @default(1)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, sequenceCode])
  @@index([organizationId, isActive])
  @@map("numbering_sequences")
  @@schema("core")
}

model ModuleStatus {
  id         String       @id @default(cuid())
  moduleKey  String       @unique
  moduleName String
  health     ModuleHealth @default(OPERATIONAL)
  message    String?
  checkedAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("module_statuses")
  @@schema("core")
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id])
  positions           Position[]
  employees           Employee[]
  employeeAssignments EmployeeAssignment[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
  @@schema("hr")
}

model Position {
  id                  String   @id @default(cuid())
  departmentId        String
  reportsToPositionId String?
  title               String
  code                String?
  description         String?
  /** Optional Role.code granted to the holder (allowlisted operational roles only — never SYSTEM_ADMINISTRATOR). */
  systemRoleCode      String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  department        Department               @relation(fields: [departmentId], references: [id])
  reportsToPosition Position?                @relation("PositionHierarchy", fields: [reportsToPositionId], references: [id], onDelete: SetNull)
  directReports     Position[]               @relation("PositionHierarchy")
  employees         Employee[]
  assignments       EmployeeAssignment[]
  jobDescriptions   PositionJobDescription[]
  userRoleGrants    UserRole[]

  leaveApprovalSteps    LeaveApprovalStep[]
  leaveAcknowledgements LeaveRequestAcknowledgement[]

  @@unique([departmentId, title])
  @@index([departmentId])
  @@index([reportsToPositionId])
  @@map("positions")
  @@schema("hr")
}

/// Current org seat: `departmentId` / `positionId` are a denormalized cache of
/// the current EmployeeAssignment (`isCurrent = true`). Writers must keep them
/// in sync inside the same transaction (see `assertCurrentSeatMatchesAssignment`).
model Employee {
  id               String           @id @default(cuid())
  organizationId   String
  departmentId     String?
  positionId       String?
  employeeNumber   String
  firstName        String
  middleName       String?
  lastName         String
  preferredName    String?
  workEmail        String?
  personalEmail    String?
  phone            String?
  /// Postal / residential address (multiline free text).
  address          String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  /// Used for Health Surcharge age exemptions (<16 / ≥60).
  dateOfBirth      DateTime?        @db.Date
  /// National Insurance Scheme number — source of truth; payroll profile mirrors for readiness/snapshots.
  nisNumber        String?
  /// Board of Inland Revenue file number — source of truth; payroll profile mirrors for readiness/snapshots.
  birNumber        String?
  idType             EmployeeIdType?
  idNumber           String?
  workforceCategory  WorkforceCategory @default(EMPLOYEE)
  employmentStatus   EmploymentStatus  @default(ACTIVE)
  employmentType     EmploymentType
  hireDate           DateTime
  terminationDate    DateTime?
  isArchived         Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id])
  department     Department?            @relation(fields: [departmentId], references: [id])
  position       Position?              @relation(fields: [positionId], references: [id])
  contracts      EmploymentContract[]
  assignments    EmployeeAssignment[]
  appraisals     PerformanceAppraisal[]
  payrollProfile PayrollProfile?
  payslips       Payslip[]
  payrollLineItems PayrollLineItem[]
  bankAccounts   EmployeeBankAccount[]
  payrollAllocations EmployeePayrollAllocation[]
  payrollPayments PayrollPayment[]

  leaveBalances     EmployeeLeaveBalance[]
  leaveTransactions LeaveBalanceTransaction[]

  leaveRequests LeaveRequest[]
  leaveAcknowledgements LeaveRequestAcknowledgement[]
  correspondences EmployeeCorrespondence[]
  credentials     EmployeeCredential[]
  trainingRecords EmployeeTrainingRecord[]
  qualificationDocuments EmployeeQualificationDocument[]
  fileChecklistItems EmployeeFileChecklistItem[]
  fileUpdateRequests EmployeeFileUpdateRequest[]
  correspondenceResponses EmployeeCorrespondenceResponse[]

  user User?

  @@unique([organizationId, employeeNumber])
  @@index([organizationId])
  @@index([organizationId, isArchived, employmentStatus])
  @@index([organizationId, workforceCategory])
  @@index([departmentId])
  @@index([positionId])
  @@map("employees")
  @@schema("hr")
}

model PositionJobDescription {
  id                        String               @id @default(cuid())
  positionId                String
  versionNumber             Int
  title                     String
  summary                   String?
  positionPurpose           String?
  reportsTo                 String?
  supervisoryResponsibility String?
  qualifications            String?
  requiredExperience        String?
  status                    JobDescriptionStatus @default(DRAFT)
  effectiveFrom             DateTime
  effectiveUntil            DateTime?
  isCurrent                 Boolean              @default(false)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  position    Position                  @relation(fields: [positionId], references: [id])
  criteria    JobDescriptionCriterion[]
  assignments EmployeeAssignment[]
  appraisals  PerformanceAppraisal[]

