  updatedAt              DateTime                    @updatedAt

  leaveRequest         LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  position             Position     @relation(fields: [positionId], references: [id], onDelete: Restrict)
  acknowledgerUser     User?        @relation("LeaveAcknowledgementUser", fields: [acknowledgerUserId], references: [id], onDelete: SetNull)
  acknowledgerEmployee Employee?    @relation(fields: [acknowledgerEmployeeId], references: [id], onDelete: SetNull)

  @@unique([leaveRequestId, sequenceNumber])
  @@index([acknowledgerUserId, status])
  @@index([leaveRequestId, status])
  @@index([positionId])
  @@map("leave_request_acknowledgements")
  @@schema("hr")
}

model LeaveAttachment {
  id               String   @id @default(cuid())
  leaveRequestId   String
  fileName         String
  storageKey       String
  mimeType         String?
  fileSize         Int?
  uploadedByUserId String?
  uploadedAt       DateTime @default(now())

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation("LeaveAttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([leaveRequestId])
  @@index([uploadedByUserId])
  @@map("leave_attachments")
  @@schema("hr")
}

/// HR correspondence / employee file letters (recommendations, discipline, etc.).
model EmployeeCorrespondence {
  id                      String                  @id @default(cuid())
  organizationId          String
  employeeId              String
  category                CorrespondenceCategory  @default(GENERAL)
  /// Free-form sub-type / tag (e.g. FIRST_WARNING, FINAL_WARNING).
  subType                 String?
  title                   String
  body                    String?
  effectiveDate           DateTime                @db.Date
  issueDate               DateTime?               @db.Date
  issuedByUserId          String?
  status                  CorrespondenceStatus    @default(DRAFT)
  employeeVisible         Boolean                 @default(true)
  /// Reporting officer (supervisor) may view the issued record read-only.
  managerVisible          Boolean                 @default(false)
  requiresAcknowledgement Boolean                 @default(false)
  /// When true, the employee may submit a written response (statement).
  allowsEmployeeResponse  Boolean                 @default(false)
  acknowledgedAt          DateTime?
  acknowledgedByUserId    String?
  retentionUntil          DateTime?               @db.Date
  /// The older letter this record replaces (supersession chain).
  supersedesId            String?                 @unique
  /// Lightweight related letter (e.g. assumption of duty linked from offer).
  relatedCorrespondenceId String?
  templateId              String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  organization     Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee         Employee                            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  issuedBy         User?                               @relation("CorrespondenceIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  acknowledgedBy   User?                               @relation("CorrespondenceAcknowledger", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  supersedes       EmployeeCorrespondence?             @relation("CorrespondenceSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy     EmployeeCorrespondence?             @relation("CorrespondenceSupersession")
  relatedCorrespondence EmployeeCorrespondence?        @relation("CorrespondenceRelated", fields: [relatedCorrespondenceId], references: [id], onDelete: SetNull)
  relatedFrom      EmployeeCorrespondence[]            @relation("CorrespondenceRelated")
  template         CorrespondenceTemplate?             @relation(fields: [templateId], references: [id], onDelete: SetNull)
  attachments      EmployeeCorrespondenceAttachment[]
  responses        EmployeeCorrespondenceResponse[]
  checklistLinks   EmployeeFileChecklistItem[]

  @@index([organizationId])
  @@index([employeeId])
  @@index([status])
  @@index([category])
  @@index([subType])
  @@index([allowsEmployeeResponse])
  @@index([issueDate])
  @@index([retentionUntil])
  @@index([issuedByUserId])
  @@index([acknowledgedByUserId])
  @@index([templateId])
  @@index([relatedCorrespondenceId])
  @@index([employeeId, status, employeeVisible])
  @@index([employeeId, managerVisible, status])
  @@index([employeeId, effectiveDate])
  @@index([organizationId, requiresAcknowledgement, status, issueDate])
  @@index([organizationId, retentionUntil, status])
  @@map("employee_correspondences")
  @@schema("hr")
}

/// Org-scoped reusable letter template with {{merge}} placeholders.
model CorrespondenceTemplate {
  id                      String                 @id @default(cuid())
  organizationId          String
  name                    String
  category                CorrespondenceCategory @default(GENERAL)
  defaultTitle            String
  /// Supports {{employeeName}}, {{position}}, {{date}}, {{employeeNumber}}.
  body                    String
  employeeVisible         Boolean                @default(true)
  requiresAcknowledgement Boolean                @default(false)
  allowsEmployeeResponse  Boolean                @default(false)
  isActive                Boolean                @default(true)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  correspondences EmployeeCorrespondence[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("correspondence_templates")
  @@schema("hr")
}

/// Certificates, licences, and other credentials held by an employee.
model EmployeeCredential {
