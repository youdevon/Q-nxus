  periodEnd              DateTime
  reviewDueDate          DateTime?
  status                 PerformanceAppraisalStatus @default(DRAFT)
  ratingScale            PerformanceRatingScale     @default(ONE_TO_FIVE)
  overallScore           Decimal?                   @db.Decimal(7, 2)
  maximumScore           Decimal                    @default(5) @db.Decimal(7, 2)
  employeeComments       String?
  supervisorComments     String?
  developmentPlan        String?
  employeeAcknowledgedAt DateTime?
  supervisorReviewedAt   DateTime?
  completedAt            DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

