enum PayFrequency {
  MONTHLY
  FORTNIGHTLY
  WEEKLY
  BIWEEKLY
  SEMI_MONTHLY

  @@schema("payroll")
}

enum PayrollPaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH

  @@schema("payroll")
}

model PayrollProfile {
  id             String               @id @default(cuid())
  employeeId     String               @unique
  payFrequency   PayFrequency         @default(MONTHLY)
  paymentMethod  PayrollPaymentMethod @default(BANK_TRANSFER)
  /// Mirrored from Employee (source of truth). Do not persist form-only NIS/BIR
  /// here from payroll writers — prefer Employee writes when people.manage.
  nisNumber      String?
  /// Mirrored from Employee (source of truth). Do not persist form-only NIS/BIR
  /// here from payroll writers — prefer Employee writes when people.manage.
  birNumber      String?
  notes          String?
  isPayrollReady Boolean              @default(false)
  /// TD1: other approved deductions (pension, annuity, tax-savings, etc.) annual TTD.
  td1OtherApprovedAnnual Decimal?     @db.Decimal(14, 2)
  /// Health Surcharge: pension as only income source (exempt when true).
  pensionOnlyIncome      Boolean      @default(false)
  /// Opt out of NIS employee/employer contributions and NIS number readiness.
  exemptFromNis              Boolean  @default(false)
  /// Opt out of Health Surcharge (in addition to age/pension exemptions).
  exemptFromHealthSurcharge  Boolean  @default(false)
  /// Opt out of PAYE and BIR number readiness.
  exemptFromPaye             Boolean  @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  employee     Employee             @relation(fields: [employeeId], references: [id])
  bankAccounts PayrollBankAccount[]

  @@map("payroll_profiles")
  @@schema("payroll")
}

/// @deprecated Prefer EmployeeBankAccount. Kept for one-release dual-read/sync.
model PayrollBankAccount {
  id               String   @id @default(cuid())
  payrollProfileId String
  bankName         String
  branchName       String?
  accountNumber    String
  accountName      String?
  /// Fixed amount for secondary accounts. Null on the primary/remainder account.
  amount           Decimal? @db.Decimal(14, 2)
  isPrimary        Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payrollProfile PayrollProfile @relation(fields: [payrollProfileId], references: [id], onDelete: Cascade)

  @@index([payrollProfileId])
  @@map("payroll_bank_accounts")
  @@schema("payroll")
}

enum FinancialInstitutionType {
  COMMERCIAL_BANK
  CREDIT_UNION
  BUILDING_SOCIETY
  LICENSED_NON_BANK
  ELECTRONIC_MONEY
  INVESTMENT_MORTGAGE_DEVELOPMENT
  CREDIT_UNION_SUPPORT
  OTHER

  @@schema("payroll")
}

enum BankAccountType {
  SAVINGS
  CHEQUING
  CURRENT
  CREDIT_UNION_SHARES
  OTHER

  @@schema("payroll")
}

enum BankAccountVerificationStatus {
  NOT_REQUIRED
  PENDING
  VERIFIED
  FAILED

  @@schema("payroll")
}

enum PayrollAllocationType {
  FULL_BALANCE
  FIXED_AMOUNT
  PERCENTAGE
  REMAINDER

  @@schema("payroll")
}

/// Configurable financial institution directory (TT seed; extensible to other jurisdictions).
model FinancialInstitution {
  id                           String                    @id @default(cuid())
  /// Stable catalog key matching tt-financial-institutions.ts ids (e.g. "fcb").
  catalogKey                   String?                   @unique
  legalName                    String
  displayName                  String
  shortName                    String
  institutionType              FinancialInstitutionType
  countryCode                  String                    @default("TT")
  currencyCode                 String                    @default("TTD")
  regulator                    String?
  regulatoryReference          String?
  localInstitutionCode         String?
  /// ACH participant code — null until confirmed. REQUIRES_CONFIRMATION.
  achParticipantCode           String?
  swiftBic                     String?
  /// ACH / local routing code — null until confirmed. REQUIRES_CONFIRMATION.
  routingCode                  String?
  requiresBranchCode           Boolean                   @default(false)
  requiresAccountType          Boolean                   @default(false)
  requiresBeneficiaryId        Boolean                   @default(false)
  requiresAccountVerification  Boolean                   @default(false)
  supportsAchCredits           Boolean                   @default(false)
  supportsAchDebits            Boolean                   @default(false)
  supportsPayrollDeposits      Boolean                   @default(true)
  supportsInternalTransfers    Boolean                   @default(false)
  supportsExternalTransfers    Boolean                   @default(false)
  supportsSplitDeposits        Boolean                   @default(true)
  isSelectableForEmployees     Boolean                   @default(true)
  isActive                     Boolean                   @default(true)
  effectiveFrom                DateTime                  @default(now())
  effectiveTo                  DateTime?
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  archivedAt                   DateTime?

  branches             FinancialInstitutionBranch[]
  employeeBankAccounts EmployeeBankAccount[]
  paymentAllocations   PayrollPaymentAllocation[]

  @@index([countryCode, isActive])
  @@index([isSelectableForEmployees, isActive])
  @@index([institutionType, isActive])
  @@map("financial_institutions")
  @@schema("payroll")
}

model FinancialInstitutionBranch {
  id            String   @id @default(cuid())
  institutionId String
  branchCode    String
  name          String
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution FinancialInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, branchCode])
  @@index([institutionId, isActive])
  @@map("financial_institution_branches")
  @@schema("payroll")
}

/// Employee-owned bank account (Phase 1 source of truth for payroll destinations).
model EmployeeBankAccount {
  id                       String                        @id @default(cuid())
  organizationId           String
  employeeId               String
  financialInstitutionId   String?
  /// Display / free-text name (institution displayName, or custom when Other).
  bankName                 String
  branchCode               String?
  branchName               String?
  accountHolderName        String?
  /// AES-256-GCM ciphertext (`v1:…`) or legacy plaintext until migrate encrypts.
  accountNumber            String
  accountNumberLastFour    String
  accountType              BankAccountType               @default(SAVINGS)
  currencyCode             String                        @default("TTD")
  nickname                 String?
  isPrimary                Boolean                       @default(false)
  isPayrollEnabled         Boolean                       @default(true)
  isVerified               Boolean                       @default(false)
  verificationStatus       BankAccountVerificationStatus @default(NOT_REQUIRED)
  verificationMethod       String?
  verifiedAt               DateTime?
  verifiedByUserId         String?
  effectiveFrom            DateTime                      @default(now())
  effectiveTo              DateTime?
  isActive                 Boolean                       @default(true)
  sortOrder                Int                           @default(0)
  createdByUserId          String?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  archivedAt               DateTime?

  organization         Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee             Employee                       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  financialInstitution FinancialInstitution?          @relation(fields: [financialInstitutionId], references: [id], onDelete: SetNull)
  allocations          EmployeePayrollAllocation[]
  paymentAllocations   PayrollPaymentAllocation[]

  @@index([employeeId, isActive])
  @@index([organizationId, employeeId])
  @@index([financialInstitutionId])
  @@map("employee_bank_accounts")
  @@schema("payroll")
}

/// Payroll deposit allocation instructions (Phase 1: FULL_BALANCE / FIXED_AMOUNT / REMAINDER).
model EmployeePayrollAllocation {
  id                    String                 @id @default(cuid())
  organizationId        String
  employeeId            String
  employeeBankAccountId String
  allocationType        PayrollAllocationType
  percentage            Decimal?               @db.Decimal(7, 4)
  fixedAmount           Decimal?               @db.Decimal(14, 2)
  priority              Int                    @default(0)
  receivesRemainder     Boolean                @default(false)
  effectiveFrom         DateTime               @default(now())
  effectiveTo           DateTime?
  isActive              Boolean                @default(true)
  createdByUserId       String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee            Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeBankAccount EmployeeBankAccount @relation(fields: [employeeBankAccountId], references: [id], onDelete: Cascade)
  paymentAllocations  PayrollPaymentAllocation[]

  @@index([employeeId, isActive])
  @@index([organizationId, employeeId])
  @@index([employeeBankAccountId])
  @@map("employee_payroll_allocations")
  @@schema("payroll")
}

/// Payment-layer status after a posted pay run is prepared for disbursement.
/// Calc (payslip) stays authoritative; these rows never rewrite net pay.
enum PayrollPaymentStatus {
  NOT_CONFIGURED
  PENDING
  PAYMENT_SETUP_REQUIRED
  PAYMENT_SETUP_ERROR
  READY
  INCLUDED_IN_BATCH
  PAID
  RECONCILED
  CANCELLED

  @@schema("payroll")
}

enum PayrollPaymentAllocationStatus {
  PENDING
  READY
  INCLUDED_IN_BATCH
  EXPORTED
  PAID
  RETURNED
  REJECTED
  FAILED
  /// Return/failure acknowledged — original failed txn preserved; no pay-run reverse.
  RESOLVED
  CANCELLED

  @@schema("payroll")
}

enum AchPaymentBatchStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  GENERATED
  EXPORTED
  CANCELLED

  @@schema("payroll")
}

enum BankExportAdapterKind {
  MANUAL_REGISTER
  GENERIC_CSV

  @@schema("payroll")
}

/// Immutable payment snapshot for one posted payslip (Phase 2 — Calc ≠ Payment).
model PayrollPayment {
  id                String               @id @default(cuid())
  organizationId    String
  payRunId          String
  payslipId         String               @unique
  employeeId        String
  netPay            Decimal              @db.Decimal(14, 2)
  allocatedAmount   Decimal              @db.Decimal(14, 2)
  unallocatedAmount Decimal              @db.Decimal(14, 2)
  paymentMethod     PayrollPaymentMethod
  paymentStatus     PayrollPaymentStatus @default(PENDING)
  currencyCode      String               @default("TTD")
  setupErrorMessage String?
  generatedAt       DateTime?
  generatedByUserId String?
  approvedAt        DateTime?
  approvedByUserId  String?
  paidAt            DateTime?
  reconciledAt      DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payRun       PayRun                     @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  payslip      Payslip                    @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  employee     Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  allocations  PayrollPaymentAllocation[]

  @@index([organizationId, payRunId])
  @@index([payRunId, paymentStatus])
  @@index([employeeId])
  @@map("payroll_payments")
  @@schema("payroll")
}

/// Frozen bank destination lines for a PayrollPayment. Never mutate when live accounts change.
model PayrollPaymentAllocation {
  id                         String                         @id @default(cuid())
  payrollPaymentId           String
  sourceAllocationId         String?
  employeeBankAccountId      String?
  financialInstitutionId     String?
  beneficiaryName            String?
  bankName                   String
  branchCode                 String?
  branchName                 String?
  accountType                BankAccountType?
  accountNumberMasked        String
  /// AES-256-GCM ciphertext (`v1:…`) or legacy plaintext until migrated.
  accountNumberEncrypted     String?
  amount                     Decimal                        @db.Decimal(14, 2)
  currencyCode               String                         @default("TTD")
  sequence                   Int                            @default(0)
  allocationKind             String
  status                     PayrollPaymentAllocationStatus @default(PENDING)
  returnCode                 String?
  returnReason               String?
  /// Amount returned / rejected (may be partial). Defaults to full line amount when unset at mark-return.
  returnedAmount             Decimal?                       @db.Decimal(14, 2)
  returnedAt                 DateTime?
  settledAt                  DateTime?
  resolutionNote             String?
  resolvedAt                 DateTime?
  resolvedByUserId           String?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt

  payrollPayment         PayrollPayment              @relation(fields: [payrollPaymentId], references: [id], onDelete: Cascade)
  sourceAllocation       EmployeePayrollAllocation?  @relation(fields: [sourceAllocationId], references: [id], onDelete: SetNull)
  employeeBankAccount    EmployeeBankAccount?        @relation(fields: [employeeBankAccountId], references: [id], onDelete: SetNull)
  financialInstitution   FinancialInstitution?       @relation(fields: [financialInstitutionId], references: [id], onDelete: SetNull)
  batchDetails           AchPaymentBatchDetail[]

  @@index([payrollPaymentId, sequence])
  @@index([employeeBankAccountId])
  @@index([financialInstitutionId])
  @@index([status])
  @@map("payroll_payment_allocations")
  @@schema("payroll")
}

/// Configurable export profile (generic CSV / manual register). No invented bank layouts.
model BankExportProfile {
  id                 String               @id @default(cuid())
  organizationId     String
  code               String
  name               String
  description        String?
  adapterKind        BankExportAdapterKind
  isDefault          Boolean              @default(false)
  /// Seeded placeholder — routing codes / official formats still REQUIRES_CONFIRMATION.
  isPlaceholder      Boolean              @default(true)
  isActive           Boolean              @default(true)
  configurationJson  Json
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches      AchPaymentBatch[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("bank_export_profiles")
  @@schema("payroll")
}

/// ACH / bank payment batch built from prepared PayrollPaymentAllocation rows.
model AchPaymentBatch {
  id                  String               @id @default(cuid())
  organizationId      String
  payRunId            String
  bankExportProfileId String
  batchNumber         String
  status              AchPaymentBatchStatus @default(DRAFT)
  currencyCode        String               @default("TTD")
  controlTotalAmount  Decimal              @db.Decimal(14, 2)
  detailCount         Int                  @default(0)
  fileName            String?
  fileStorageKey      String?
  fileContentHash     String?
  fileMimeType        String?
  preparedByUserId    String?
  preparedAt          DateTime?
  approvedByUserId    String?
  approvedAt          DateTime?
  generatedAt         DateTime?
  exportedAt          DateTime?
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payRun            PayRun                @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  bankExportProfile BankExportProfile     @relation(fields: [bankExportProfileId], references: [id], onDelete: Restrict)
  details           AchPaymentBatchDetail[]

  @@unique([organizationId, batchNumber])
  @@index([payRunId, status])
  @@index([organizationId, status])
  @@index([bankExportProfileId])
  @@map("ach_payment_batches")
  @@schema("payroll")
}

model AchPaymentBatchDetail {
  id                         String   @id @default(cuid())
  achPaymentBatchId          String
  payrollPaymentAllocationId String
  sequence                   Int      @default(0)
  amount                     Decimal  @db.Decimal(14, 2)
  currencyCode               String   @default("TTD")
  employeeNumber             String
  employeeName               String
  bankName                   String
  accountNumberMasked        String
  allocationKind             String
  createdAt                  DateTime @default(now())

  achPaymentBatch          AchPaymentBatch            @relation(fields: [achPaymentBatchId], references: [id], onDelete: Cascade)
  payrollPaymentAllocation PayrollPaymentAllocation   @relation(fields: [payrollPaymentAllocationId], references: [id], onDelete: Restrict)

  @@unique([achPaymentBatchId, payrollPaymentAllocationId])
  @@index([achPaymentBatchId, sequence])
  @@map("ach_payment_batch_details")
  @@schema("payroll")
}

/// Trinidad & Tobago NIS earnings-class bands (fixed weekly employee/employer amounts).
model NisEarningsClass {
  id                   String    @id @default(cuid())
  organizationId       String
  /// Roman numeral class code, e.g. I–XVI.
  classCode            String
  /// Lower bound of monthly insurable earnings (inclusive).
  monthlyMin           Decimal   @db.Decimal(14, 2)
  /// Upper bound of monthly insurable earnings (inclusive). Null = no cap (Class XVI).
  monthlyMax           Decimal?  @db.Decimal(14, 2)
  employeeWeeklyAmount Decimal   @db.Decimal(10, 2)
  employerWeeklyAmount Decimal   @db.Decimal(10, 2)
  effectiveFrom        DateTime  @db.Date
  effectiveTo          DateTime? @db.Date
  /// Optional label for the schedule, e.g. "2026".
  versionLabel         String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, classCode, effectiveFrom])
  @@index([organizationId, effectiveFrom])
  @@index([organizationId, isActive])
  @@map("nis_earnings_classes")
  @@schema("payroll")
}

/// Trinidad & Tobago PAYE (income tax) parameters — annual brackets, not flat monthly %.
model PayeTaxConfig {
  id                         String    @id @default(cuid())
  organizationId             String
  /// Resident personal allowance (annual), e.g. 90,000.
  personalAllowanceAnnual    Decimal   @db.Decimal(14, 2)
  /// Portion of employee NIS deductible for PAYE, e.g. 0.70.
  nisDeductiblePortion       Decimal   @db.Decimal(5, 4)
  /// Cap on pension/annuity/tax-savings + allowable NIS portion (annual), e.g. 60,000.
  approvedDeductionCapAnnual Decimal   @db.Decimal(14, 2)
  effectiveFrom              DateTime  @db.Date
  effectiveTo                DateTime? @db.Date
  versionLabel               String?
  isActive                   Boolean   @default(true)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brackets     PayeTaxBracket[]

  @@unique([organizationId, effectiveFrom])
  @@index([organizationId, isActive])
  @@map("paye_tax_configs")
  @@schema("payroll")
}

model PayeTaxBracket {
  id             String  @id @default(cuid())
  payeTaxConfigId String
  /// Upper bound of chargeable income for this band (inclusive). Null = open-ended.
  upToAmount     Decimal? @db.Decimal(14, 2)
  ratePercent    Decimal  @db.Decimal(7, 4)
  sortOrder      Int      @default(0)

  config PayeTaxConfig @relation(fields: [payeTaxConfigId], references: [id], onDelete: Cascade)

  @@index([payeTaxConfigId, sortOrder])
  @@map("paye_tax_brackets")
  @@schema("payroll")
}

/// Trinidad & Tobago Health Surcharge — fixed weekly amounts by earnings tier.
model HealthSurchargeConfig {
  id                        String    @id @default(cuid())
  organizationId            String
  /// Weekly amount when earnings exceed the threshold (e.g. 8.25).
  higherWeeklyAmount        Decimal   @db.Decimal(10, 2)
  /// Weekly amount at or below the threshold (e.g. 4.80).
  lowerWeeklyAmount         Decimal   @db.Decimal(10, 2)
  /// Weekly earnings above this amount use the higher rate (e.g. 109).
  weeklyEarningsThreshold   Decimal   @db.Decimal(14, 2)
  /// Monthly earnings above this amount use the higher rate (e.g. 469.99).
  monthlyEarningsThreshold  Decimal   @db.Decimal(14, 2)
  /// Under this age: exempt (e.g. 16).
  underAgeExempt            Int       @default(16)
  /// Age at or above: exempt (e.g. 60).
  seniorAgeExempt           Int       @default(60)
  effectiveFrom             DateTime  @db.Date
  effectiveTo               DateTime? @db.Date
  versionLabel              String?
  isActive                  Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, effectiveFrom])
  @@index([organizationId, isActive])
  @@map("health_surcharge_configs")
  @@schema("payroll")
}

