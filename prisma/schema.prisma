  @@schema("hr")
}

/// Distinguishes full HR employees from non-employee payees (agents, board, contractors).
/// Non-EMPLOYEE categories use EmploymentContract for time-bounded engagement; they do not get employee files.
enum WorkforceCategory {
  EMPLOYEE
  AGENT
  BOARD
  /// Consultants and similar non-employee payees.
  CONTRACTOR

  @@schema("hr")
}

/// Government / travel identity document used for employee verification.
enum EmployeeIdType {
  NATIONAL_ID
  DRIVERS_PERMIT
  /// Passport or foreign ID for non-nationals.
  NON_NATIONAL

  @@schema("hr")
}

enum EmailDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED

  @@schema("notifications")
}

enum EmailPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@schema("notifications")
}

enum NotificationSeverity {
  SUCCESS
  INFORMATION
  WARNING
  ERROR
  CRITICAL

  @@schema("notifications")
}

enum NotificationReadStatus {
  UNREAD
  READ
  DISMISSED

  @@schema("notifications")
}

model Organization {
  id              String             @id @default(cuid())
  code            String             @unique
  name            String
  shortName       String?
  legalName       String?
  email           String?
  phone           String?
  website         String?
  status          OrganizationStatus @default(DRAFT)
  defaultTimeZone String             @default("America/Port_of_Spain")
  defaultCurrency String             @default("TTD")
  defaultLanguage String             @default("en")
  dateFormat      String             @default("dd/MM/yyyy")
  firstDayOfWeek  Int                @default(1)
  version         Int                @default(1)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  archivedAt      DateTime?

  departments         Department[]
  users               User[]
  employees           Employee[]
  roles               Role[]
  businessUnits       BusinessUnit[]
  locations           Location[]
  referenceDataSets   ReferenceDataSet[]
  featureControls     FeatureControl[]
  domainSettings      DomainSetting[]
  numberingSequences  NumberingSequence[]
  allowanceCategories AllowanceCategory[]

  leaveTypes            LeaveType[]
  leaveEntitlementRules LeaveEntitlementRule[]
  organizationHolidays  OrganizationHoliday[]

  leaveRequests LeaveRequest[]
  employeeCorrespondences EmployeeCorrespondence[]
  correspondenceTemplates CorrespondenceTemplate[]
  employeeCredentials     EmployeeCredential[]
  employeeTrainingRecords EmployeeTrainingRecord[]
  employeeQualificationDocuments EmployeeQualificationDocument[]
  employeeFileChecklistItems EmployeeFileChecklistItem[]
  employeeFileUpdateRequests EmployeeFileUpdateRequest[]
  employeeCorrespondenceResponses EmployeeCorrespondenceResponse[]
  storedFiles              StoredFile[]
  employeeFilePacks            EmployeeFilePack[]
  employeeLifecycleTemplates   EmployeeLifecycleTemplate[]
  employeeOnboardingCases      EmployeeOnboardingCase[]
  employeeOffboardingCases     EmployeeOffboardingCase[]

  nisEarningsClasses       NisEarningsClass[]
  payeTaxConfigs           PayeTaxConfig[]
  healthSurchargeConfigs   HealthSurchargeConfig[]
  employeeTaxProfiles      EmployeeTaxProfile[]
  employeePriorEmploymentYtds EmployeePriorEmploymentYtd[]
  employeePayrollStatutoryOverrides EmployeePayrollStatutoryOverride[]
  employeeAnnualPayrollProjections EmployeeAnnualPayrollProjection[]
  employeeTaxYearAdjustments EmployeeTaxYearAdjustment[]
  employeeEarningTreatmentOverrides EmployeeEarningTreatmentOverride[]
  payrollPeriods           PayrollPeriod[]
  payRuns                  PayRun[]
  payslips                 Payslip[]
  payrollLineItems         PayrollLineItem[]
  payrollComponentDefinitions PayrollComponentDefinition[]
  employeePayrollRecurringItems EmployeePayrollRecurringItem[]
  employeeBankAccounts     EmployeeBankAccount[]
  employeePayrollAllocations EmployeePayrollAllocation[]
  payrollPayments          PayrollPayment[]
  achPaymentBatches        AchPaymentBatch[]
  bankExportProfiles       BankExportProfile[]
  auditEvents              AuditEvent[]

  @@index([status])
  @@map("organizations")
  @@schema("core")
}

model OrganizationHoliday {
  id             String   @id @default(cuid())
  organizationId String
  holidayDate    DateTime @db.Date
  name           String
  isRecurring    Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, holidayDate, name])
  @@index([organizationId, holidayDate])
  @@index([organizationId, isActive])
  @@map("organization_holidays")
  @@schema("hr")
}

model ApplicationSetting {
  id               String   @id @default(cuid())
  internalCodename String   @default("Q-NXUS")
  displayName      String   @default("Q-NXUS")
  shortName        String   @default("Q-NXUS")
  organizationName String?
  logoUrl          String?
  faviconUrl       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("application_settings")
  @@schema("core")
}

model User {
  id                  String            @id @default(cuid())
  organizationId      String
  email               String            @unique
  firstName           String
  lastName            String
  passwordHash        String?
  mustChangePassword  Boolean           @default(false)
  status              UserAccountStatus @default(INVITED)
  isActive            Boolean           @default(true)
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int               @default(0)
  lockedUntil         DateTime?
  version             Int               @default(1)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  archivedAt          DateTime?

  organization         Organization            @relation(fields: [organizationId], references: [id])
  roles                UserRole[]
  notifications        NotificationRecipient[]
  auditEvents          AuditEvent[]
  supervisedAppraisals PerformanceAppraisal[]  @relation("AppraisalSupervisor")

  createdLeaveTransactions LeaveBalanceTransaction[] @relation("LeaveTransactionCreator")

  createdLeaveRequests     LeaveRequest[]      @relation("LeaveRequestCreator")
  finalLeaveDecisions      LeaveRequest[]      @relation("LeaveFinalDecisionUser")
  leaveApprovalSteps       LeaveApprovalStep[] @relation("LeaveApprovalUser")
  leaveAcknowledgements    LeaveRequestAcknowledgement[] @relation("LeaveAcknowledgementUser")
  uploadedLeaveAttachments LeaveAttachment[]   @relation("LeaveAttachmentUploader")

  issuedCorrespondences              EmployeeCorrespondence[] @relation("CorrespondenceIssuer")
  acknowledgedCorrespondences        EmployeeCorrespondence[] @relation("CorrespondenceAcknowledger")
  uploadedCorrespondenceAttachments  EmployeeCorrespondenceAttachment[] @relation("CorrespondenceAttachmentUploader")
  confirmedAssumptionOfDutyItems     EmployeeFileChecklistItem[] @relation("AssumptionOfDutyConfirmer")
  requestedFileUpdates               EmployeeFileUpdateRequest[] @relation("FileUpdateRequester")
  resolvedFileUpdates                EmployeeFileUpdateRequest[] @relation("FileUpdateResolver")
  reviewedCorrespondenceResponses      EmployeeCorrespondenceResponse[] @relation("CorrespondenceResponseReviewer")

  approvedEmploymentContracts        EmploymentContract[] @relation("ContractApprovedBy")
  contractApprovalSteps              EmploymentContractApprovalStep[] @relation("ContractApprovalUser")
  uploadedStoredFiles                StoredFile[] @relation("StoredFileUploader")
  openedOnboardingCases              EmployeeOnboardingCase[] @relation("OnboardingCaseOpener")
  openedOffboardingCases             EmployeeOffboardingCase[] @relation("OffboardingCaseOpener")
  ownedOnboardingCases               EmployeeOnboardingCase[] @relation("OnboardingCaseOwner")
  ownedOffboardingCases              EmployeeOffboardingCase[] @relation("OffboardingCaseOwner")
  completedOnboardingTasks           EmployeeOnboardingTask[] @relation("OnboardingTaskCompleter")
  completedOffboardingTasks          EmployeeOffboardingTask[] @relation("OffboardingTaskCompleter")
  assignedOnboardingTasks            EmployeeOnboardingTask[] @relation("OnboardingTaskAssignee")
  assignedOffboardingTasks           EmployeeOffboardingTask[] @relation("OffboardingTaskAssignee")
  createdPayrollRecurringItems       EmployeePayrollRecurringItem[] @relation("PayrollRecurringItemCreator")

  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("users")
  @@schema("core")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String?
  code           String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?    @relation(fields: [organizationId], references: [id])
  users        UserRole[]
  permissions  RolePermission[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
  @@schema("core")
}

model UserRole {
  id               String               @id @default(cuid())
  userId           String
  roleId           String
  status           RoleAssignmentStatus @default(ACTIVE)
  effectiveFrom    DateTime             @default(now())
  effectiveUntil   DateTime?
  assignedAt       DateTime             @default(now())
  revokedAt        DateTime?
  reason           String?
  /// Provenance for sync/revoke — do not infer from reason text.
  source           UserRoleSource       @default(MANUAL)
  /// When source is POSITION, the Position that granted this role (optional).
  sourcePositionId String?

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  sourcePosition Position? @relation(fields: [sourcePositionId], references: [id], onDelete: SetNull)

  /// Partial unique for ACTIVE/PENDING grants: see migration
  /// `user_roles_userId_roleId_active_key` (revoked rows may reuse the pair).
  @@index([userId, status])
  @@index([roleId, status])
  @@index([userId, source, status])
  @@index([effectiveFrom, effectiveUntil])
  @@index([sourcePositionId])
  @@map("user_roles")
  @@schema("core")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  moduleKey   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@index([moduleKey])
  @@map("permissions")
  @@schema("core")
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
  @@schema("core")
}

model BusinessUnit {
  id             String              @id @default(cuid())
  organizationId String
  parentId       String?
  code           String
  name           String
  description    String?
  status         ConfigurationStatus @default(ACTIVE)
  effectiveFrom  DateTime            @default(now())
  effectiveUntil DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  parent       BusinessUnit?  @relation("BusinessUnitHierarchy", fields: [parentId], references: [id])
  children     BusinessUnit[] @relation("BusinessUnitHierarchy")

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([parentId])
  @@map("business_units")
  @@schema("core")
}

model Location {
  id             String              @id @default(cuid())
  organizationId String
  code           String
  name           String
  locationType   String
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  countryCode    String              @default("TT")
  postalCode     String?
  timeZone       String              @default("America/Port_of_Spain")
  status         ConfigurationStatus @default(ACTIVE)
  effectiveFrom  DateTime            @default(now())
  effectiveUntil DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("locations")
  @@schema("core")
}

model ReferenceDataSet {
  id             String              @id @default(cuid())
  organizationId String?
  code           String
  name           String
  description    String?
  moduleKey      String
  status         ConfigurationStatus @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization?        @relation(fields: [organizationId], references: [id])
  values       ReferenceDataValue[]

  @@unique([organizationId, code])
  @@index([moduleKey])
  @@map("reference_data_sets")
  @@schema("core")
}

model ReferenceDataValue {
  id             String              @id @default(cuid())
  dataSetId      String
  parentId       String?
  code           String
  label          String
  description    String?
  sortOrder      Int                 @default(0)
  status         ConfigurationStatus @default(ACTIVE)
  effectiveFrom  DateTime            @default(now())
  effectiveUntil DateTime?
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  dataSet  ReferenceDataSet     @relation(fields: [dataSetId], references: [id], onDelete: Cascade)
  parent   ReferenceDataValue?  @relation("ReferenceValueHierarchy", fields: [parentId], references: [id])
  children ReferenceDataValue[] @relation("ReferenceValueHierarchy")

  @@unique([dataSetId, code])
  @@index([dataSetId, status])
  @@index([parentId])
  @@map("reference_data_values")
  @@schema("core")
}

model FeatureControl {
  id             String              @id @default(cuid())
  organizationId String
  featureCode    String
  isEnabled      Boolean             @default(false)
  status         ConfigurationStatus @default(ACTIVE)
  effectiveFrom  DateTime            @default(now())
  effectiveUntil DateTime?
  reason         String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, featureCode])
  @@index([organizationId, isEnabled])
  @@map("feature_controls")
  @@schema("core")
}

model DomainSetting {
  id             String              @id @default(cuid())
  organizationId String
  settingCode    String
  moduleKey      String
  name           String
  description    String?
  dataType       SettingDataType
  value          Json
  isSensitive    Boolean             @default(false)
  status         ConfigurationStatus @default(ACTIVE)
  effectiveFrom  DateTime            @default(now())
  effectiveUntil DateTime?
  version        Int                 @default(1)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, settingCode])
  @@index([organizationId, moduleKey])
  @@map("domain_settings")
  @@schema("core")
}

model NumberingSequence {
  id             String                 @id @default(cuid())
  organizationId String
  sequenceCode   String
  prefix         String?
  suffix         String?
  currentNumber  BigInt                 @default(0)
  minimumLength  Int                    @default(5)
  resetFrequency SequenceResetFrequency @default(NEVER)
  lastResetAt    DateTime?
  isActive       Boolean                @default(true)
  version        Int                    @default(1)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, sequenceCode])
  @@index([organizationId, isActive])
  @@map("numbering_sequences")
  @@schema("core")
}

model ModuleStatus {
  id         String       @id @default(cuid())
  moduleKey  String       @unique
  moduleName String
  health     ModuleHealth @default(OPERATIONAL)
  message    String?
  checkedAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("module_statuses")
  @@schema("core")
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id])
  positions           Position[]
  employees           Employee[]
  employeeAssignments EmployeeAssignment[]
  employmentContracts EmploymentContract[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
  @@schema("hr")
}

model Position {
  id                  String   @id @default(cuid())
  departmentId        String
  reportsToPositionId String?
  title               String
  code                String?
  description         String?
  /** Optional Role.code granted to the holder (allowlisted operational roles only — never SYSTEM_ADMINISTRATOR). */
  systemRoleCode      String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  department        Department               @relation(fields: [departmentId], references: [id])
  reportsToPosition Position?                @relation("PositionHierarchy", fields: [reportsToPositionId], references: [id], onDelete: SetNull)
  directReports     Position[]               @relation("PositionHierarchy")
  employees         Employee[]
  assignments       EmployeeAssignment[]
  jobDescriptions   PositionJobDescription[]
  userRoleGrants    UserRole[]

  leaveApprovalSteps    LeaveApprovalStep[]
  leaveAcknowledgements LeaveRequestAcknowledgement[]
  employmentContracts   EmploymentContract[]
  contractApprovalSteps EmploymentContractApprovalStep[]

  @@unique([departmentId, title])
  @@index([departmentId])
  @@index([reportsToPositionId])
  @@map("positions")
  @@schema("hr")
}

/// Current org seat: `departmentId` / `positionId` are a denormalized cache of
/// the current EmployeeAssignment (`isCurrent = true`). Writers must keep them
/// in sync inside the same transaction (see `assertCurrentSeatMatchesAssignment`).
model Employee {
  id               String           @id @default(cuid())
  organizationId   String
  departmentId     String?
  positionId       String?
  employeeNumber   String
  firstName        String
  middleName       String?
  lastName         String
  preferredName    String?
  workEmail        String?
  personalEmail    String?
  phone            String?
  /// Postal / residential address (multiline free text).
  address          String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  /// Used for Health Surcharge age exemptions (<16 / ≥60).
  dateOfBirth      DateTime?        @db.Date
  /// National Insurance Scheme number — source of truth for payroll readiness / payslip snapshots.
  nisNumber        String?
  /// Board of Inland Revenue file number — source of truth for payroll readiness / payslip snapshots.
  birNumber        String?
  idType             EmployeeIdType?
  idNumber           String?
  workforceCategory  WorkforceCategory @default(EMPLOYEE)
  employmentStatus   EmploymentStatus  @default(ACTIVE)
  employmentType     EmploymentType
  hireDate           DateTime
  terminationDate    DateTime?
  isArchived         Boolean           @default(false)
  /// When set, employee file uploads/edits are blocked (offboarding freeze).
  fileFrozenAt       DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id])
  department     Department?            @relation(fields: [departmentId], references: [id])
  position       Position?              @relation(fields: [positionId], references: [id])
  contracts      EmploymentContract[]
  assignments    EmployeeAssignment[]
  appraisals     PerformanceAppraisal[]
  payrollProfile PayrollProfile?
  taxProfiles    EmployeeTaxProfile[]
  priorEmploymentYtds EmployeePriorEmploymentYtd[]
  statutoryOverrides  EmployeePayrollStatutoryOverride[]
  annualPayrollProjections EmployeeAnnualPayrollProjection[]
  taxYearAdjustments  EmployeeTaxYearAdjustment[]
  earningTreatmentOverrides EmployeeEarningTreatmentOverride[]
  payslips       Payslip[]
  payrollLineItems PayrollLineItem[]
  payrollRecurringItems EmployeePayrollRecurringItem[]
  bankAccounts   EmployeeBankAccount[]
  payrollAllocations EmployeePayrollAllocation[]
  payrollPayments PayrollPayment[]

  leaveBalances     EmployeeLeaveBalance[]
  leaveTransactions LeaveBalanceTransaction[]

  leaveRequests LeaveRequest[]
  leaveAcknowledgements LeaveRequestAcknowledgement[]
  correspondences EmployeeCorrespondence[]
  credentials     EmployeeCredential[]
  trainingRecords EmployeeTrainingRecord[]
  qualificationDocuments EmployeeQualificationDocument[]
  fileChecklistItems EmployeeFileChecklistItem[]
  fileUpdateRequests EmployeeFileUpdateRequest[]
  correspondenceResponses EmployeeCorrespondenceResponse[]
  onboardingCases EmployeeOnboardingCase[]
  offboardingCases EmployeeOffboardingCase[]

  user User?

  @@unique([organizationId, employeeNumber])
  @@index([organizationId])
  @@index([organizationId, isArchived, employmentStatus])
  @@index([organizationId, workforceCategory])
  @@index([departmentId])
  @@index([positionId])
  @@map("employees")
  @@schema("hr")
}

model PositionJobDescription {
  id                        String               @id @default(cuid())
  positionId                String
  versionNumber             Int
  title                     String
  summary                   String?
  positionPurpose           String?
  reportsTo                 String?
  supervisoryResponsibility String?
  qualifications            String?
  requiredExperience        String?
  status                    JobDescriptionStatus @default(DRAFT)
  effectiveFrom             DateTime
  effectiveUntil            DateTime?
  isCurrent                 Boolean              @default(false)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  position    Position                  @relation(fields: [positionId], references: [id])
  criteria    JobDescriptionCriterion[]
  assignments EmployeeAssignment[]
  appraisals  PerformanceAppraisal[]

  @@unique([positionId, versionNumber])
  @@index([positionId])
  @@index([status])
  @@index([isCurrent])
  @@map("position_job_descriptions")
  @@schema("hr")
}

model JobDescriptionCriterion {
  id               String           @id @default(cuid())
  jobDescriptionId String
  criterionType    JobCriterionType
  title            String
  description      String?
  measurement      String?
  weight           Decimal          @default(0) @db.Decimal(5, 2)
  sortOrder        Int              @default(0)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  jobDescription PositionJobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)

  @@index([jobDescriptionId])
  @@index([criterionType])
  @@map("job_description_criteria")
  @@schema("hr")
}

model EmployeeAssignment {
  id               String                 @id @default(cuid())
  employeeId       String
  departmentId     String
  positionId       String?
  jobDescriptionId String?
  assignmentType   EmployeeAssignmentType @default(INITIAL_APPOINTMENT)
  startDate        DateTime
  endDate          DateTime?
  /// At most one row per employee may be true — enforced by partial unique index
  /// `employee_assignments_one_current` (see migration; not expressible as @@unique).
  isCurrent        Boolean                @default(true)
  isActing         Boolean                @default(false)
  referenceNumber  String?
  reason           String?
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  employee       Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department     Department              @relation(fields: [departmentId], references: [id])
  position       Position?               @relation(fields: [positionId], references: [id])
  jobDescription PositionJobDescription? @relation(fields: [jobDescriptionId], references: [id])
  appraisals     PerformanceAppraisal[]

  @@index([employeeId])
  @@index([departmentId])
  @@index([positionId])
  @@index([jobDescriptionId])
  @@index([employeeId, isCurrent])
  @@index([isCurrent, positionId])
  @@index([startDate])
  @@map("employee_assignments")
  @@schema("hr")
}

model LeaveType {
  id                     String    @id @default(cuid())
  organizationId         String
  code                   String
  name                   String
  description            String?
  unit                   LeaveUnit @default(DAYS)
  isPaid                 Boolean   @default(true)
