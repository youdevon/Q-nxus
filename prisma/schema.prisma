/// Uploaded qualification proof (e.g. one CXC certificate) with many subject line items.
model EmployeeQualificationDocument {
  id              String                     @id @default(cuid())
  organizationId  String
  employeeId      String
  title           String
  documentType    QualificationDocumentType  @default(OTHER)
  /// Category subtype (e.g. CSEC, CAPE, IGCSE, ACCA). Stored as string for presets + free entry.
  qualificationSubtype String?
  /// Set when documentType is UNIVERSITY (specific award code, e.g. BSC, MBA, PHD).
  degreeType      QualificationDegreeType?
  /// Display name when subtype/degreeType is OTHER / free-text, or legacy custom labels.
  customTypeLabel String?
  /// Optional programme / field of study (typically UNIVERSITY awards).
  programme       String?
  issuer          String?
  issueDate       DateTime?                  @db.Date
  year            Int?
  employeeVisible Boolean                    @default(true)
  fileName        String?
  storageKey      String?
  mimeType        String?
  fileSize        Int?
  /// HR-only notes; not shown on employee self-service.
  notes           String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee                      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  entries      EmployeeQualificationEntry[]
  checklistLinks EmployeeFileChecklistItem[]

  @@index([organizationId])
  @@index([employeeId])
  @@index([documentType])
  @@map("employee_qualification_documents")
  @@schema("hr")
}

/// Subject / result line under a qualification document (e.g. Mathematics Grade I).
model EmployeeQualificationEntry {
  id            String  @id @default(cuid())
  documentId    String
  subjectOrName String
  gradeOrResult String?
  level         String?
  sortOrder     Int     @default(0)

  document EmployeeQualificationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, sortOrder])
  @@map("employee_qualification_entries")
  @@schema("hr")
}

/// Per-employee status / links for the standard employee-file document checklist.
/// Status is primarily derived from linked qualifications, credentials, and
/// correspondence; this row stores overrides (N/A, manual assumption signed)
/// and explicit links when HR pins a record.
model EmployeeFileChecklistItem {
  id                          String                       @id @default(cuid())
  organizationId              String
  employeeId                  String
  itemType                    EmployeeFileChecklistItemType
  /// Marriage certificate (and optionally assumption of duty) can be marked N/A.
  notApplicable               Boolean                      @default(false)
  /// HR-only notes; not shown on employee self-service.
  notes                       String?
  qualificationDocumentId     String?
  credentialId                String?
  correspondenceId            String?
  /// Fallback attachment when no module record is used.
  fileName                    String?
  storageKey                  String?
  mimeType                    String?
  fileSize                    Int?
  /// Manual confirmation that assumption of duty was signed (when no letter ack).
  assumptionOfDutySignedAt    DateTime?
  assumptionOfDutyConfirmedByUserId String?
  /// Whether the employee can see this checklist item and its direct attachment.
  employeeVisible             Boolean                      @default(true)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  organization              Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee                  Employee                       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
