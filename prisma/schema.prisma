model AuditEvent {
  id             String   @id @default(cuid())
  userId         String?
  moduleKey      String
  action         String
  entityType     String
  entityId       String?
  description    String?
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  clientHostName String?
  correlationId  String?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([moduleKey])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
  @@schema("audit")
}
