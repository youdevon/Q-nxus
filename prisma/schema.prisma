  isPlaceholder      Boolean              @default(true)
  isActive           Boolean              @default(true)
  configurationJson  Json
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches      AchPaymentBatch[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("bank_export_profiles")
  @@schema("payroll")
}

/// ACH / bank payment batch built from prepared PayrollPaymentAllocation rows.
model AchPaymentBatch {
  id                  String               @id @default(cuid())
  organizationId      String
  payRunId            String
  bankExportProfileId String
  batchNumber         String
  status              AchPaymentBatchStatus @default(DRAFT)
  currencyCode        String               @default("TTD")
  controlTotalAmount  Decimal              @db.Decimal(14, 2)
  /// Sum of approved payroll net payments included in this batch (validation baseline).
  payrollNetTotal     Decimal?             @db.Decimal(14, 2)
  detailCount         Int                  @default(0)
  effectivePaymentDate DateTime?           @db.Date
  /// PPD (payroll default) or CCD (future company payments).
  achType             String?
  purposeCode         String?
  entryDescription    String?
  globalAddenda       String?
  discretionaryData   String?
  transactionType     String?
  validationSummaryJson Json?
  fileName            String?
  fileStorageKey      String?
  fileContentHash     String?
  fileMimeType        String?
  preparedByUserId    String?
  preparedAt          DateTime?
  approvedByUserId    String?
  approvedAt          DateTime?
  generatedAt         DateTime?
  exportedAt          DateTime?
  releasedAt          DateTime?
  releasedByUserId    String?
  reconciledAt        DateTime?
  reconciledByUserId  String?
  /// Prior batch this one supersedes (after cancel).
  supersedesBatchId   String?
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payRun            PayRun                @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  bankExportProfile BankExportProfile     @relation(fields: [bankExportProfileId], references: [id], onDelete: Restrict)
  details           AchPaymentBatchDetail[]

  @@unique([organizationId, batchNumber])
  @@index([payRunId, status])
  @@index([organizationId, status])
  @@index([bankExportProfileId])
  @@map("ach_payment_batches")
  @@schema("payroll")
}

model AchPaymentBatchDetail {
  id                         String   @id @default(cuid())
  achPaymentBatchId          String
  payrollPaymentAllocationId String
  sequence                   Int      @default(0)
  amount                     Decimal  @db.Decimal(14, 2)
  currencyCode               String   @default("TTD")
  /// Frozen First Citizens template fields (Individual Name / ID / ABA / …).
  employeeNumber             String
  employeeName               String
  individualId               String?
  bankName                   String
  abaNumber                  String?
  accountNumberMasked        String
  paymentType                String?
  purposeCode                String?
  addenda                    String?
  allocationKind             String
  createdAt                  DateTime @default(now())

  achPaymentBatch          AchPaymentBatch            @relation(fields: [achPaymentBatchId], references: [id], onDelete: Cascade)
  payrollPaymentAllocation PayrollPaymentAllocation   @relation(fields: [payrollPaymentAllocationId], references: [id], onDelete: Restrict)

  @@unique([achPaymentBatchId, payrollPaymentAllocationId])
  @@index([achPaymentBatchId, sequence])
  @@map("ach_payment_batch_details")
  @@schema("payroll")
}

/// Trinidad & Tobago NIS earnings-class bands (fixed weekly employee/employer amounts).
model NisEarningsClass {
  id                   String    @id @default(cuid())
  organizationId       String
  /// Roman numeral class code, e.g. I–XVI.
  classCode            String
  /// Lower bound of monthly insurable earnings (inclusive).
  monthlyMin           Decimal   @db.Decimal(14, 2)
  /// Upper bound of monthly insurable earnings (inclusive). Null = no cap (Class XVI).
  monthlyMax           Decimal?  @db.Decimal(14, 2)
  employeeWeeklyAmount Decimal   @db.Decimal(10, 2)
  employerWeeklyAmount Decimal   @db.Decimal(10, 2)
  effectiveFrom        DateTime  @db.Date
  effectiveTo          DateTime? @db.Date
  /// Optional label for the schedule, e.g. "2026".
  versionLabel         String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, classCode, effectiveFrom])
  @@index([organizationId, effectiveFrom])
  @@index([organizationId, isActive])
  @@map("nis_earnings_classes")
  @@schema("payroll")
}

/// Trinidad & Tobago PAYE (income tax) parameters — annual brackets, not flat monthly %.
model PayeTaxConfig {
  id                         String    @id @default(cuid())
  organizationId             String
  /// ISO country for this schedule (default TT).
  countryCode                String    @default("TT")
  /// Calendar tax year this schedule is intended for (defaults from effectiveFrom).
  taxYear                    Int?
  currencyCode               String    @default("TTD")
  /// Resident personal allowance (annual), e.g. 90,000.
  personalAllowanceAnnual    Decimal   @db.Decimal(14, 2)
  /// Portion of employee NIS deductible for PAYE, e.g. 0.70.
  nisDeductiblePortion       Decimal   @db.Decimal(5, 4)
  /// Cap on pension/annuity/tax-savings + allowable NIS portion (annual), e.g. 60,000.
  approvedDeductionCapAnnual Decimal   @db.Decimal(14, 2)
  effectiveFrom              DateTime  @db.Date
  effectiveTo                DateTime? @db.Date
  versionLabel               String?
  /// Official circular / gazette / advisor memo reference.
  sourceReference            String?
  approvedByUserId           String?
  approvedAt                 DateTime?
  isActive                   Boolean   @default(true)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brackets     PayeTaxBracket[]

  @@unique([organizationId, effectiveFrom])
  @@index([organizationId, isActive])
  @@index([organizationId, taxYear])
  @@index([organizationId, countryCode, effectiveFrom])
  @@map("paye_tax_configs")
  @@schema("payroll")
}

model PayeTaxBracket {
  id             String  @id @default(cuid())
  payeTaxConfigId String
  /// Upper bound of chargeable income for this band (inclusive). Null = open-ended.
  upToAmount     Decimal? @db.Decimal(14, 2)
  ratePercent    Decimal  @db.Decimal(7, 4)
  sortOrder      Int      @default(0)

  config PayeTaxConfig @relation(fields: [payeTaxConfigId], references: [id], onDelete: Cascade)

  @@index([payeTaxConfigId, sortOrder])
  @@map("paye_tax_brackets")
  @@schema("payroll")
}

/// Trinidad & Tobago Health Surcharge — fixed weekly amounts by earnings tier.
model HealthSurchargeConfig {
  id                        String    @id @default(cuid())
  organizationId            String
  /// Weekly amount when earnings exceed the threshold (e.g. 8.25).
  higherWeeklyAmount        Decimal   @db.Decimal(10, 2)
  /// Weekly amount at or below the threshold (e.g. 4.80).
  lowerWeeklyAmount         Decimal   @db.Decimal(10, 2)
  /// Weekly earnings above this amount use the higher rate (e.g. 109).
  weeklyEarningsThreshold   Decimal   @db.Decimal(14, 2)
  /// Monthly earnings above this amount use the higher rate (e.g. 469.99).
  monthlyEarningsThreshold  Decimal   @db.Decimal(14, 2)
  /// Under this age: exempt (e.g. 16).
  underAgeExempt            Int       @default(16)
  /// Age at or above: exempt (e.g. 60).
  seniorAgeExempt           Int       @default(60)
  effectiveFrom             DateTime  @db.Date
  effectiveTo               DateTime? @db.Date
  versionLabel              String?
  isActive                  Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, effectiveFrom])
  @@index([organizationId, isActive])
  @@map("health_surcharge_configs")
  @@schema("payroll")
}

enum PayrollPeriodStatus {
  OPEN
  CLOSED

  @@schema("payroll")
}

enum PayRunStatus {
  DRAFT
  /// Figures reviewed and approved for posting (maker-checker).
  APPROVED
  /// Amounts frozen; payslips immutable.
  POSTED
  /// Payments matched / returns resolved for this run.
  RECONCILED
  /// Terminal — no further payment or reopen without a new run.
  CLOSED

  @@schema("payroll")
}

enum PayRunKind {
  REGULAR
  CORRECTION
  OFF_CYCLE

  @@schema("payroll")
}

enum PayrollLineItemType {
  EARNING
  DEDUCTION

  @@schema("payroll")
}

enum PayrollLineItemCode {
  CORRECTION_EARNING
  CORRECTION_DEDUCTION
  OVERTIME
  BONUS
  COMMISSION
  OTHER_EARNING
  OTHER_DEDUCTION

  @@schema("payroll")
}

enum PayslipRecordStatus {
  DRAFT
  EXCLUDED
  POSTED

  @@schema("payroll")
}

/// Delivery outcome for a released payslip email (distinct from notifications.EmailDeliveryStatus).
enum PayslipEmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED

  @@schema("payroll")
}

/// Calendar span for which employees are paid (e.g. July 2026 monthly).
model PayrollPeriod {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  year           Int
  /// 1–12 for monthly periods; null reserved for non-monthly frequencies.
  month          Int?
  frequency      PayFrequency        @default(MONTHLY)
  /// Stable key within frequency, e.g. "2026-07" for monthly.
  periodKey      String
  periodStart    DateTime            @db.Date
  periodEnd      DateTime            @db.Date
  status         PayrollPeriodStatus @default(OPEN)
  notes          String?
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payRuns      PayRun[]
  payslips     Payslip[]

  @@unique([organizationId, periodKey, frequency])
  @@index([organizationId, year, month])
  @@index([organizationId, status])
  @@map("payroll_periods")
  @@schema("payroll")
}

/// Processing event for a payroll period — draft calc then posted freeze.
/// REGULAR is the primary monthly run. CORRECTION / OFF_CYCLE are additional
/// runs on the same period after a posted regular (never rewrite the original).
model PayRun {
  id              String       @id @default(cuid())
  organizationId  String
  payrollPeriodId String
  runNumber       String
  status          PayRunStatus @default(DRAFT)
  runKind         PayRunKind   @default(REGULAR)
  /// Optional link to the posted run this correction/off-cycle adjusts.
  sourcePayRunId  String?
  currency        String       @default("TTD")
  employeeCount   Int          @default(0)
  totalGross      Decimal      @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal      @default(0) @db.Decimal(14, 2)
  totalNet        Decimal      @default(0) @db.Decimal(14, 2)
  notes           String?
  /// Set when a reviewer approves the draft figures (maker-checker). Cleared on recalc.
  approvedAt      DateTime?
  approvedById    String?
  approvalNote    String?
  postedAt        DateTime?
  postedById      String?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Restrict so deleting a period cannot wipe pay runs (including posted history).
  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  sourcePayRun  PayRun?       @relation("PayRunSource", fields: [sourcePayRunId], references: [id], onDelete: SetNull)
  derivedRuns   PayRun[]      @relation("PayRunSource")
  payslips      Payslip[]
  lineItems     PayrollLineItem[]
  payrollPayments PayrollPayment[]
  achPaymentBatches AchPaymentBatch[]

  @@unique([organizationId, runNumber])
  @@index([payrollPeriodId])
  @@index([organizationId, status])
  @@index([organizationId, runKind])
  @@index([organizationId, createdAt])
  @@index([sourcePayRunId])
  @@index([approvedById])
  @@map("pay_runs")
  @@schema("payroll")
}

/// Employee result for a pay run. Posted rows store an immutable snapshot.
model Payslip {
  id                     String              @id @default(cuid())
  organizationId         String
  payRunId               String
  payrollPeriodId        String
  employeeId             String
  status                 PayslipRecordStatus @default(DRAFT)
  currency               String
  grossPay               Decimal             @db.Decimal(14, 2)
  totalDeductions        Decimal             @db.Decimal(14, 2)
  netPay                 Decimal             @db.Decimal(14, 2)
  /// Denormalized statutory lines for YTD/report sums without loading snapshot JSON.
  payeAmount             Decimal             @default(0) @db.Decimal(14, 2)
  nisEmployeeAmount      Decimal             @default(0) @db.Decimal(14, 2)
  healthSurchargeAmount  Decimal             @default(0) @db.Decimal(14, 2)
  baseSalary             Decimal             @db.Decimal(14, 2)
  allowancesTotal        Decimal             @db.Decimal(14, 2)
  monthlyTaxableEarnings Decimal             @db.Decimal(14, 2)
  employeeNumber         String
  employeeName           String
  nisNumber              String?
  birNumber              String?
  jobTitle               String?
  departmentName         String?
  payFrequency           String
  paymentMethod          String
  /// Frozen PayslipPreview + document meta — authoritative once POSTED.
  snapshot               Json
  /// Manual exclusion from a draft pay run (reason required). Cleared on re-include.
  excludedAt             DateTime?
  excludedByUserId       String?
  exclusionReason        String?
  /// Set when payroll releases the posted slip for employee self-service + email.
  releasedAt             DateTime?
  releasedById           String?
  /// Null until release; then PENDING/SENT/FAILED/SKIPPED for email delivery.
  emailDeliveryStatus    PayslipEmailDeliveryStatus?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payRun        PayRun        @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id])
  lineItems     PayrollLineItem[]
  payrollPayment PayrollPayment?

  @@unique([payRunId, employeeId])
  @@index([organizationId, employeeId, status])
  @@index([payrollPeriodId])
  @@index([employeeId, status, createdAt])
  @@index([payRunId, status])
  @@index([payRunId, releasedAt])
  @@index([employeeId, releasedAt])
  @@map("payslips")
  @@schema("payroll")
}

/// Manual draft-run additions/deductions such as correction deltas, overtime, bonuses, and commissions.
model PayrollLineItem {
  id             String              @id @default(cuid())
  organizationId String
  payRunId       String
  payslipId      String
  employeeId     String
  lineType       PayrollLineItemType
  code           PayrollLineItemCode
  label          String
  amount         Decimal             @db.Decimal(14, 2)
  isTaxable      Boolean             @default(true)
  notes          String?
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payRun       PayRun       @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  payslip      Payslip      @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([payRunId])
  @@index([payslipId])
  @@index([employeeId])
  @@index([organizationId, createdAt])
  @@map("payroll_line_items")
  @@schema("payroll")
}

/// Org-scoped reusable earning/deduction masters (loans, garnishments, allowances, etc.).
enum PayrollComponentKind {
  EARNING
  DEDUCTION

  @@schema("payroll")
}

enum PayrollComponentCategory {
  LOAN
  GARNISHMENT
  PENSION_INSTALLMENT
  VOLUNTARY_DEDUCTION
  RECURRING_EARNING

  @@schema("payroll")
}

model PayrollComponentDefinition {
  id             String                    @id @default(cuid())
  organizationId String
  code           String
  name           String
  kind           PayrollComponentKind
  category       PayrollComponentCategory
  isTaxable      Boolean                   @default(false)
  /// Phase 6: finer tax treatment; isTaxable remains the PAYE/NIS gross flag.
  taxTreatment   PayrollTaxTreatment       @default(NON_TAXABLE)
  isActive       Boolean                   @default(true)
  defaultAmount  Decimal?                  @db.Decimal(14, 2)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organization Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  EmployeePayrollRecurringItem[]
  treatmentOverrides EmployeeEarningTreatmentOverride[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([organizationId, kind, isActive])
  @@map("payroll_component_definitions")
  @@schema("payroll")
}

/// Employee assignment of a recurring component with optional declining balance.
model EmployeePayrollRecurringItem {
  id               String    @id @default(cuid())
  organizationId   String
  employeeId       String
  definitionId     String
  amount           Decimal   @db.Decimal(14, 2)
  /// When set, period amount is min(amount, remainingBalance) and decreases on post.
  remainingBalance Decimal?  @db.Decimal(14, 2)
  startDate        DateTime  @db.Date
  endDate          DateTime? @db.Date
  isActive         Boolean   @default(true)
  notes            String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  definition   PayrollComponentDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  createdBy    User?                     @relation("PayrollRecurringItemCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([employeeId, isActive])
  @@index([organizationId, employeeId])
  @@index([definitionId])
  @@index([organizationId, isActive, startDate])
  @@map("employee_payroll_recurring_items")
  @@schema("payroll")
}

model Notification {
  id          String               @id @default(cuid())
  title       String
  message     String
  severity    NotificationSeverity
  moduleKey   String
  actionUrl   String?
  relatedType String?
  relatedId   String?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())

  recipients NotificationRecipient[]

  @@index([moduleKey])
  @@index([createdAt])
  @@index([relatedType, relatedId])
  @@index([expiresAt])
  @@map("notifications")
  @@schema("notifications")
}

model NotificationRecipient {
  notificationId String
  userId         String
  status         NotificationReadStatus @default(UNREAD)
  readAt         DateTime?
  dismissedAt    DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, status])
  @@map("notification_recipients")
  @@schema("notifications")
}

model EmailDelivery {
  id                  String              @id @default(cuid())
  notificationId      String?
  templateKey         String?
  moduleKey           String?
  relatedType         String?
  relatedId           String?
  recipientUserId     String?
  recipientEmail      String
  recipientName       String?
  subject             String
  textBody            String?
  htmlBody            String?
  priority            EmailPriority       @default(NORMAL)
  status              EmailDeliveryStatus @default(PENDING)
  attemptCount        Int                 @default(0)
  maximumAttempts     Int                 @default(3)
  nextAttemptAt       DateTime?
  processingStartedAt DateTime?
  sentAt              DateTime?
  failedAt            DateTime?
  cancelledAt         DateTime?
  lastError           String?
  messageId           String?
  smtpResponse        String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  attempts EmailDeliveryAttempt[]

  @@index([status, nextAttemptAt])
  @@index([recipientUserId])
  @@index([recipientEmail])
  @@index([notificationId])
  @@index([moduleKey])
  @@index([relatedType, relatedId])
  @@index([createdAt])
  @@map("email_deliveries")
  @@schema("notifications")
}

model EmailDeliveryAttempt {
  id              String              @id @default(cuid())
  emailDeliveryId String
  attemptNumber   Int
  status          EmailDeliveryStatus
  startedAt       DateTime            @default(now())
  completedAt     DateTime?
  errorMessage    String?
  smtpResponse    String?
  messageId       String?
  createdAt       DateTime            @default(now())

  emailDelivery EmailDelivery @relation(fields: [emailDeliveryId], references: [id], onDelete: Cascade)

  @@index([emailDeliveryId])
  @@index([status])
  @@index([createdAt])
  @@map("email_delivery_attempts")
  @@schema("notifications")
}

model AuditEvent {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  moduleKey      String
  action         String
  entityType     String
  entityId       String?
  description    String?
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  clientHostName String?
  correlationId  String?
  createdAt      DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([moduleKey])
  @@index([moduleKey, action, createdAt])
  @@index([entityType, entityId])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("audit_events")
  @@schema("audit")
}
