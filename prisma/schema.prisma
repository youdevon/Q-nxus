enum PayFrequency {
  MONTHLY
  FORTNIGHTLY
  WEEKLY
  BIWEEKLY
  SEMI_MONTHLY

  @@schema("payroll")
}

enum PayrollPaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH

  @@schema("payroll")
}

/// How PAYE is determined for an employee in a tax year.
enum TaxCalculationMethod {
  STANDARD_CUMULATIVE
  STANDARD_NON_CUMULATIVE
  PREVIOUS_INCOME_INCLUDED
  MANUAL_INSTRUCTION
  SPECIAL_IRD_INSTRUCTION

  @@schema("payroll")
}

enum PersonalAllowanceSource {
  STATUTORY_DEFAULT
  TD1
  IRD_INSTRUCTION
  MANUAL_AUTHORIZED

  @@schema("payroll")
}

enum EmployeeTaxProfileStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  ARCHIVED

  @@schema("payroll")
}

/// Per-employee, per-calendar-tax-year PAYE / TD1 treatment.
/// Per-employee, per-tax-year PAYE / TD1 treatment (sole store for TD1 amounts).
model EmployeeTaxProfile {
  id                 String                   @id @default(cuid())
  organizationId     String
  employeeId         String
  taxYear            Int
  taxCalculationMethod TaxCalculationMethod   @default(STANDARD_NON_CUMULATIVE)
  taxProfileStatus   EmployeeTaxProfileStatus @default(ACTIVE)

  /// Override of org PayeTaxConfig.personalAllowanceAnnual when set.
  personalAllowance          Decimal?                 @db.Decimal(14, 2)
  personalAllowanceSource    PersonalAllowanceSource  @default(STATUTORY_DEFAULT)

  td1Submitted               Boolean   @default(false)
  td1EffectiveDate           DateTime? @db.Date
  td1ApprovedByIrd           Boolean   @default(false)
  td1ApprovalReference       String?
  /// TD1 other approved deductions (pension, annuity, tax-savings) annual TTD.
  td1OtherApprovedAnnual     Decimal?  @db.Decimal(14, 2)
  td1StoredFileId            String?

  cumulativeCalculationEnabled Boolean @default(false)
  previousEmploymentDeclared   Boolean @default(false)
  previousEmploymentVerified   Boolean @default(false)
  /// Free-text source hint; structured YTD lives on EmployeePriorEmploymentYtd.
  previousEmploymentSource     String?

  effectiveFrom    DateTime  @db.Date
  effectiveTo      DateTime? @db.Date
  notes            String?
  createdByUserId  String?
  updatedByUserId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  td1StoredFile StoredFile? @relation(fields: [td1StoredFileId], references: [id], onDelete: SetNull)
  priorEmploymentYtds EmployeePriorEmploymentYtd[]

  @@unique([employeeId, taxYear])
  @@index([organizationId, taxYear])
  @@index([organizationId, taxProfileStatus])
  @@index([td1StoredFileId])
  @@map("employee_tax_profiles")
  @@schema("payroll")
}

enum PriorEmploymentDocumentType {
  TD4
  PRIOR_EMPLOYER_LETTER
  PAYSLIP
  OTHER

  @@schema("payroll")
}

enum PriorEmploymentRecordStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  ARCHIVED

  @@schema("payroll")
}

enum PayrollTaxTreatment {
  TAXABLE_EMPLOYMENT
  NON_TAXABLE
  NIS_ONLY
  PAYE_EXEMPT

  @@schema("payroll")
}

enum StatutoryOverrideStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  APPLIED
  CANCELLED

  @@schema("payroll")
}

/// Prior-employer calendar-year YTD amounts for mid-year joiners (Phase 3).
/// Applied to cumulative PAYE in Phase 4; stored and resolved here.
model EmployeePriorEmploymentYtd {
  id               String                      @id @default(cuid())
  organizationId   String
  employeeId       String
  taxYear          Int
  taxProfileId     String?
  employerName     String
  employerBirNumber String?
  employmentStartDate DateTime?                @db.Date
  employmentEndDate   DateTime?                @db.Date
  /// Date the YTD figures are stated as-of (usually last day with prior employer).
  asOfDate         DateTime                    @db.Date
  currencyCode     String                      @default("TTD")

  taxableIncomeYtd            Decimal @db.Decimal(14, 2)
  payeDeductedYtd             Decimal @db.Decimal(14, 2)
  nisEmployeeYtd              Decimal? @db.Decimal(14, 2)
  nisEmployerYtd              Decimal? @db.Decimal(14, 2)
  healthSurchargeYtd          Decimal? @db.Decimal(14, 2)
  otherApprovedDeductionsYtd  Decimal? @db.Decimal(14, 2)

  status           PriorEmploymentRecordStatus @default(ACTIVE)
  verified         Boolean                     @default(false)
  verifiedAt       DateTime?
  verifiedByUserId String?
  notes            String?
  createdByUserId  String?
  updatedByUserId  String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  taxProfile   EmployeeTaxProfile? @relation(fields: [taxProfileId], references: [id], onDelete: SetNull)
  documents    EmployeePriorEmploymentDocument[]

  @@index([employeeId, taxYear])
  @@index([organizationId, taxYear])
  @@index([taxProfileId])
  @@index([organizationId, status])
