  @@unique([contractId, leaveTypeId, cycleStart, cycleEnd])
  @@index([employeeId])
  @@index([employeeId, cycleStart, cycleEnd])
  @@index([contractId, leaveTypeId])
  @@index([leaveTypeId])
  @@index([availableBalance])
