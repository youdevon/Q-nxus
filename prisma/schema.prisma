generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["core", "hr", "payroll", "notifications", "audit"]
}

enum ModuleHealth {
  OPERATIONAL
  DEGRADED
  UNAVAILABLE

  @@schema("core")
}

enum OrganizationStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  INACTIVE
  ARCHIVED

  @@schema("core")
}

enum UserAccountStatus {
  INVITED
  ACTIVE
  LOCKED
  SUSPENDED
  DISABLED
  ARCHIVED

  @@schema("core")
}

enum RoleAssignmentStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED

  @@schema("core")
}

enum ConfigurationStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED

  @@schema("core")
}

enum SettingDataType {
  STRING
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
  DATETIME
  JSON

  @@schema("core")
}

enum SequenceResetFrequency {
  NEVER
  MONTHLY
  ANNUALLY
  FINANCIAL_YEAR
  MANUAL

  @@schema("core")
}

enum EmployeeAssignmentType {
  INITIAL_APPOINTMENT
  TRANSFER
  PROMOTION
  DEMOTION
  ACTING_APPOINTMENT
  TEMPORARY_ASSIGNMENT
  SECONDMENT
  REASSIGNMENT
  RETURN_TO_SUBSTANTIVE
  OTHER

  @@schema("hr")
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RETIRED
  INACTIVE

  @@schema("hr")
}

enum JobDescriptionStatus {
  DRAFT
  ACTIVE
  RETIRED
  ARCHIVED

  @@schema("hr")
}

enum JobCriterionType {
  DUTY
  RESPONSIBILITY
  PERFORMANCE_OBJECTIVE
  KEY_PERFORMANCE_INDICATOR
  TECHNICAL_COMPETENCY
  BEHAVIOURAL_COMPETENCY
  QUALIFICATION
  EXPERIENCE
  OTHER

  @@schema("hr")
}

enum AllowanceFrequency {
  MONTHLY
  WEEKLY
  BIWEEKLY
  PER_PAY_PERIOD
  ANNUAL
  ONE_TIME

  @@schema("hr")
}

enum EmploymentContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  SUPERSEDED
  TERMINATED
  CANCELLED

  @@schema("hr")
}

enum EmploymentContractType {
  PERMANENT
  FIXED_TERM
  TEMPORARY
  PART_TIME
  INTERNSHIP
  CONSULTANCY
  ACTING
  SECONDMENT
  OTHER

  @@schema("hr")
}

enum ContractChangeType {
  INITIAL
  RENEWAL
  EXTENSION
  AMENDMENT
  SALARY_ADJUSTMENT
  POSITION_CHANGE
  TERMINATION
  OTHER

  @@schema("hr")
}

enum LeaveUnit {
  DAYS
  HOURS

  @@schema("hr")
}

enum LeaveAccrualMethod {
  ANNUAL_GRANT
  MONTHLY
  PER_PAY_PERIOD
  MANUAL
  NONE

  @@schema("hr")
}

enum LeaveBalanceTransactionType {
  OPENING_BALANCE
  ENTITLEMENT
  ACCRUAL
  CARRY_FORWARD
  REQUEST_RESERVED
  REQUEST_RELEASED
  LEAVE_TAKEN
  ADJUSTMENT
  EXPIRY
  REVERSAL

  @@schema("hr")
}

enum LeaveRequestStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  MANAGER_APPROVED
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN

  @@schema("hr")
}

enum LeaveApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
  CANCELLED

  @@schema("hr")
}

enum PerformanceAppraisalStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  SUPERVISOR_REVIEWED
  EMPLOYEE_ACKNOWLEDGED
  COMPLETED
  CANCELLED

  @@schema("hr")
}

enum PerformanceRatingScale {
  ONE_TO_FIVE
  ONE_TO_TEN
  PERCENTAGE

  @@schema("hr")
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  TEMPORARY
  PART_TIME
  INTERN
  CONSULTANT

  @@schema("hr")
}

enum EmailDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED

  @@schema("notifications")
}

enum EmailPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@schema("notifications")
}

enum NotificationSeverity {
  SUCCESS
  INFORMATION
  WARNING
  ERROR
  CRITICAL

  @@schema("notifications")
}

enum NotificationReadStatus {
  UNREAD
  READ
  DISMISSED

  @@schema("notifications")
}

model Organization {
  id              String             @id @default(cuid())
  code            String             @unique
  name            String
  shortName       String?
  legalName       String?
  email           String?
  phone           String?
  website         String?
  status          OrganizationStatus @default(DRAFT)
  defaultTimeZone String             @default("America/Port_of_Spain")
  defaultCurrency String             @default("TTD")
  defaultLanguage String             @default("en")
  dateFormat      String             @default("dd/MM/yyyy")
  firstDayOfWeek  Int                @default(1)
  version         Int                @default(1)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  archivedAt      DateTime?

  departments         Department[]
  users               User[]
  employees           Employee[]
  roles               Role[]
  businessUnits       BusinessUnit[]
  locations           Location[]
  referenceDataSets   ReferenceDataSet[]
  featureControls     FeatureControl[]
  domainSettings      DomainSetting[]
  numberingSequences  NumberingSequence[]
  allowanceCategories AllowanceCategory[]

  leaveTypes            LeaveType[]
  leaveEntitlementRules LeaveEntitlementRule[]
  organizationHolidays  OrganizationHoliday[]

  leaveRequests LeaveRequest[]

  statutoryRates           StatutoryRate[]
  nisEarningsClasses       NisEarningsClass[]
  payeTaxConfigs           PayeTaxConfig[]
  healthSurchargeConfigs   HealthSurchargeConfig[]
  payrollPeriods           PayrollPeriod[]
  payRuns                  PayRun[]
  payslips                 Payslip[]

  @@index([status])
  @@map("organizations")
  @@schema("core")
}

model OrganizationHoliday {
  id             String   @id @default(cuid())
  organizationId String
  holidayDate    DateTime @db.Date
  name           String
  isRecurring    Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, holidayDate, name])
  @@index([organizationId, holidayDate])
  @@index([organizationId, isActive])
  @@map("organization_holidays")
  @@schema("hr")
}

model ApplicationSetting {
  id               String   @id @default(cuid())
  internalCodename String   @default("Q-NXUS")
  displayName      String   @default("Q-NXUS")
  shortName        String   @default("Q-NXUS")
  organizationName String?
  logoUrl          String?
  faviconUrl       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("application_settings")
  @@schema("core")
}

model User {
  id                  String            @id @default(cuid())
  organizationId      String
  email               String            @unique
  firstName           String
  lastName            String
  passwordHash        String?
  mustChangePassword  Boolean           @default(false)
  status              UserAccountStatus @default(INVITED)
  isActive            Boolean           @default(true)
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int               @default(0)
  lockedUntil         DateTime?
  version             Int               @default(1)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  archivedAt          DateTime?

  organization         Organization            @relation(fields: [organizationId], references: [id])
  roles                UserRole[]
  notifications        NotificationRecipient[]
  auditEvents          AuditEvent[]
  supervisedAppraisals PerformanceAppraisal[]  @relation("AppraisalSupervisor")

  createdLeaveTransactions LeaveBalanceTransaction[] @relation("LeaveTransactionCreator")

  createdLeaveRequests     LeaveRequest[]      @relation("LeaveRequestCreator")
  finalLeaveDecisions      LeaveRequest[]      @relation("LeaveFinalDecisionUser")
  leaveApprovalSteps       LeaveApprovalStep[] @relation("LeaveApprovalUser")
  uploadedLeaveAttachments LeaveAttachment[]   @relation("LeaveAttachmentUploader")

  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("users")
  @@schema("core")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String?
  code           String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?    @relation(fields: [organizationId], references: [id])
  users        UserRole[]
  permissions  RolePermission[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
  @@schema("core")
}

model UserRole {
  id             String               @id @default(cuid())
  userId         String
  roleId         String
  status         RoleAssignmentStatus @default(ACTIVE)
  effectiveFrom  DateTime             @default(now())
  effectiveUntil DateTime?
  assignedAt     DateTime             @default(now())
  revokedAt      DateTime?
  reason         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([roleId, status])
  @@index([effectiveFrom, effectiveUntil])
  @@map("user_roles")
  @@schema("core")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  moduleKey   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@index([moduleKey])
  @@map("permissions")
  @@schema("core")
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
  @@schema("core")
}

model BusinessUnit {
  id             String              @id @default(cuid())
  organizationId String
  parentId       String?
  code           String
  name           String
  description    String?
  status         ConfigurationStatus @default(ACTIVE)
  effectiveFrom  DateTime            @default(now())
  effectiveUntil DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  parent       BusinessUnit?  @relation("BusinessUnitHierarchy", fields: [parentId], references: [id])
  children     BusinessUnit[] @relation("BusinessUnitHierarchy")

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([parentId])
  @@map("business_units")
  @@schema("core")
}

model Location {
  id             String              @id @default(cuid())
  organizationId String
  code           String
  name           String
  locationType   String
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  countryCode    String              @default("TT")
  postalCode     String?
  timeZone       String              @default("America/Port_of_Spain")
  status         ConfigurationStatus @default(ACTIVE)
  effectiveFrom  DateTime            @default(now())
  effectiveUntil DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("locations")
  @@schema("core")
}

model ReferenceDataSet {
  id             String              @id @default(cuid())
  organizationId String?
  code           String
  name           String
  description    String?
  moduleKey      String
  status         ConfigurationStatus @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization?        @relation(fields: [organizationId], references: [id])
  values       ReferenceDataValue[]

  @@unique([organizationId, code])
  @@index([moduleKey])
  @@map("reference_data_sets")
  @@schema("core")
}

model ReferenceDataValue {
  id             String              @id @default(cuid())
  dataSetId      String
  parentId       String?
  code           String
  label          String
  description    String?
  sortOrder      Int                 @default(0)
  status         ConfigurationStatus @default(ACTIVE)
  effectiveFrom  DateTime            @default(now())
  effectiveUntil DateTime?
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  dataSet  ReferenceDataSet     @relation(fields: [dataSetId], references: [id], onDelete: Cascade)
  parent   ReferenceDataValue?  @relation("ReferenceValueHierarchy", fields: [parentId], references: [id])
  children ReferenceDataValue[] @relation("ReferenceValueHierarchy")

  @@unique([dataSetId, code])
  @@index([dataSetId, status])
  @@index([parentId])
  @@map("reference_data_values")
  @@schema("core")
}

model FeatureControl {
  id             String              @id @default(cuid())
  organizationId String
  featureCode    String
  isEnabled      Boolean             @default(false)
  status         ConfigurationStatus @default(ACTIVE)
  effectiveFrom  DateTime            @default(now())
  effectiveUntil DateTime?
  reason         String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, featureCode])
  @@index([organizationId, isEnabled])
  @@map("feature_controls")
  @@schema("core")
}

model DomainSetting {
  id             String              @id @default(cuid())
  organizationId String
  settingCode    String
  moduleKey      String
  name           String
  description    String?
  dataType       SettingDataType
  value          Json
  isSensitive    Boolean             @default(false)
  status         ConfigurationStatus @default(ACTIVE)
  effectiveFrom  DateTime            @default(now())
  effectiveUntil DateTime?
  version        Int                 @default(1)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, settingCode])
  @@index([organizationId, moduleKey])
  @@map("domain_settings")
  @@schema("core")
}

model NumberingSequence {
  id             String                 @id @default(cuid())
  organizationId String
  sequenceCode   String
  prefix         String?
  suffix         String?
  currentNumber  BigInt                 @default(0)
  minimumLength  Int                    @default(5)
  resetFrequency SequenceResetFrequency @default(NEVER)
  lastResetAt    DateTime?
  isActive       Boolean                @default(true)
  version        Int                    @default(1)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, sequenceCode])
  @@index([organizationId, isActive])
  @@map("numbering_sequences")
  @@schema("core")
}

model ModuleStatus {
  id         String       @id @default(cuid())
  moduleKey  String       @unique
  moduleName String
  health     ModuleHealth @default(OPERATIONAL)
  message    String?
  checkedAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("module_statuses")
  @@schema("core")
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id])
  positions           Position[]
  employees           Employee[]
  employeeAssignments EmployeeAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
  @@schema("hr")
}

model Position {
  id                  String   @id @default(cuid())
  departmentId        String
  reportsToPositionId String?
  title               String
  code                String?
  description         String?
  /** Optional Role.code granted to the holder (e.g. HR_ADMINISTRATOR, SYSTEM_ADMINISTRATOR). */
  systemRoleCode      String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  department        Department               @relation(fields: [departmentId], references: [id])
  reportsToPosition Position?                @relation("PositionHierarchy", fields: [reportsToPositionId], references: [id], onDelete: SetNull)
  directReports     Position[]               @relation("PositionHierarchy")
  employees         Employee[]
  assignments       EmployeeAssignment[]
  jobDescriptions   PositionJobDescription[]

  leaveApprovalSteps LeaveApprovalStep[]

  @@unique([departmentId, title])
  @@index([departmentId])
  @@index([reportsToPositionId])
  @@map("positions")
  @@schema("hr")
}

model Employee {
  id               String           @id @default(cuid())
  organizationId   String
  departmentId     String?
  positionId       String?
  employeeNumber   String
  firstName        String
  middleName       String?
  lastName         String
  preferredName    String?
  workEmail        String?
  personalEmail    String?
  phone            String?
  /// Used for Health Surcharge age exemptions (<16 / ≥60).
  dateOfBirth      DateTime?        @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE)
  employmentType   EmploymentType
  hireDate         DateTime
  terminationDate  DateTime?
  isArchived       Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id])
  department     Department?            @relation(fields: [departmentId], references: [id])
  position       Position?              @relation(fields: [positionId], references: [id])
  contracts      EmploymentContract[]
  assignments    EmployeeAssignment[]
  appraisals     PerformanceAppraisal[]
  payrollProfile PayrollProfile?
  payslips       Payslip[]

  leaveBalances     EmployeeLeaveBalance[]
  leaveTransactions LeaveBalanceTransaction[]

  leaveRequests LeaveRequest[]

  user User?

  @@unique([organizationId, employeeNumber])
  @@index([organizationId])
  @@index([departmentId])
  @@index([positionId])
  @@map("employees")
  @@schema("hr")
}

model PositionJobDescription {
  id                        String               @id @default(cuid())
  positionId                String
  versionNumber             Int
  title                     String
  summary                   String?
  positionPurpose           String?
  reportsTo                 String?
  supervisoryResponsibility String?
  qualifications            String?
  requiredExperience        String?
  status                    JobDescriptionStatus @default(DRAFT)
  effectiveFrom             DateTime
  effectiveUntil            DateTime?
  isCurrent                 Boolean              @default(false)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  position    Position                  @relation(fields: [positionId], references: [id])
  criteria    JobDescriptionCriterion[]
  assignments EmployeeAssignment[]
  appraisals  PerformanceAppraisal[]

  @@unique([positionId, versionNumber])
  @@index([positionId])
  @@index([status])
  @@index([isCurrent])
  @@map("position_job_descriptions")
  @@schema("hr")
}

model JobDescriptionCriterion {
  id               String           @id @default(cuid())
  jobDescriptionId String
  criterionType    JobCriterionType
  title            String
  description      String?
  measurement      String?
  weight           Decimal          @default(0) @db.Decimal(5, 2)
  sortOrder        Int              @default(0)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  jobDescription PositionJobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)

  @@index([jobDescriptionId])
  @@index([criterionType])
  @@map("job_description_criteria")
  @@schema("hr")
}

model EmployeeAssignment {
  id               String                 @id @default(cuid())
  employeeId       String
  departmentId     String
  positionId       String?
  jobDescriptionId String?
  assignmentType   EmployeeAssignmentType @default(INITIAL_APPOINTMENT)
  startDate        DateTime
  endDate          DateTime?
  isCurrent        Boolean                @default(true)
  isActing         Boolean                @default(false)
  referenceNumber  String?
  reason           String?
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  employee       Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department     Department              @relation(fields: [departmentId], references: [id])
  position       Position?               @relation(fields: [positionId], references: [id])
  jobDescription PositionJobDescription? @relation(fields: [jobDescriptionId], references: [id])
  appraisals     PerformanceAppraisal[]

  @@index([employeeId])
  @@index([departmentId])
  @@index([positionId])
  @@index([jobDescriptionId])
  @@index([employeeId, isCurrent])
  @@index([startDate])
  @@map("employee_assignments")
  @@schema("hr")
}

model LeaveType {
  id                     String    @id @default(cuid())
  organizationId         String
  code                   String
  name                   String
  description            String?
  unit                   LeaveUnit @default(DAYS)
  isPaid                 Boolean   @default(true)
  requiresBalance        Boolean   @default(true)
  requiresDocument       Boolean   @default(false)
  documentRequiredAfter  Decimal?  @db.Decimal(7, 2)
  minimumNoticeDays      Int       @default(0)
  maximumConsecutiveDays Decimal?  @db.Decimal(7, 2)
  allowsHalfDay          Boolean   @default(false)
  allowsNegativeBalance  Boolean   @default(false)
  carryForwardAllowed    Boolean   @default(false)
  carryForwardLimit      Decimal?  @db.Decimal(9, 2)
  carryForwardExpiryDays Int?
  colour                 String?
  sortOrder              Int       @default(0)
  isSystem               Boolean   @default(false)
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entitlementRules LeaveEntitlementRule[]
  balances         EmployeeLeaveBalance[]
  transactions     LeaveBalanceTransaction[]

  requests LeaveRequest[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@index([sortOrder])
  @@map("leave_types")
  @@schema("hr")
}

model LeaveEntitlementRule {
  id                   String             @id @default(cuid())
  organizationId       String
  leaveTypeId          String
  name                 String
  employmentType       EmploymentType?
  minimumServiceMonths Int                @default(0)
  maximumServiceMonths Int?
  annualEntitlement    Decimal            @default(0) @db.Decimal(9, 2)
  accrualMethod        LeaveAccrualMethod @default(ANNUAL_GRANT)
  accrualAmount        Decimal?           @db.Decimal(9, 4)
  maximumBalance       Decimal?           @db.Decimal(9, 2)
  prorateFirstYear     Boolean            @default(true)
  prorateFinalYear     Boolean            @default(true)
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  priority             Int                @default(0)
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leaveTypeId])
  @@index([employmentType])
  @@index([effectiveFrom, effectiveTo])
  @@index([priority])
  @@map("leave_entitlement_rules")
  @@schema("hr")
}

model EmployeeLeaveBalance {
  id               String    @id @default(cuid())
  employeeId       String
  contractId       String
  leaveTypeId      String
  cycleStart       DateTime
  cycleEnd         DateTime
  openingBalance   Decimal   @default(0) @db.Decimal(9, 2)
  entitlement      Decimal   @default(0) @db.Decimal(9, 2)
  accrued          Decimal   @default(0) @db.Decimal(9, 2)
  carriedForward   Decimal   @default(0) @db.Decimal(9, 2)
  adjustments      Decimal   @default(0) @db.Decimal(9, 2)
  reserved         Decimal   @default(0) @db.Decimal(9, 2)
  taken            Decimal   @default(0) @db.Decimal(9, 2)
  expired          Decimal   @default(0) @db.Decimal(9, 2)
  availableBalance Decimal   @default(0) @db.Decimal(9, 2)
  lastCalculatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee     Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contract     EmploymentContract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  leaveType    LeaveType                 @relation(fields: [leaveTypeId], references: [id])
  transactions LeaveBalanceTransaction[]

  requests LeaveRequest[]

  @@unique([contractId, leaveTypeId])
  @@index([employeeId])
  @@index([employeeId, cycleStart, cycleEnd])
  @@index([contractId])
  @@index([leaveTypeId])
  @@index([availableBalance])
  @@map("employee_leave_balances")
  @@schema("hr")
}

model LeaveBalanceTransaction {
  id              String                      @id @default(cuid())
  employeeId      String
  contractId      String
  leaveTypeId     String
  leaveBalanceId  String?
  transactionType LeaveBalanceTransactionType
  quantity        Decimal                     @db.Decimal(9, 2)
